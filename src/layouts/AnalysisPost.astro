---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getLangFromUrl, useTranslations, getLocalePath } from '../i18n/utils';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: any;
	pilier: string;
	tags?: string[];
	chapo?: string;
	lang?: string;
}

const { title, description, pubDate, updatedDate, heroImage, pilier, tags = [], chapo } = Astro.props;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang as 'fr' | 'en' | 'zh');
const htmlLang = lang === 'zh' ? 'zh-Hant' : lang;

const pilierLabels: Record<string, Record<string, string>> = {
	energie: { fr: 'Énergie', en: 'Energy', zh: '能源' },
	taiwan: { fr: 'Taïwan', en: 'Taiwan', zh: '台灣' },
	'indo-pacifique': { fr: 'Indo-Pacifique', en: 'Indo-Pacific', zh: '印太' },
	notes: { fr: 'Notes', en: 'Notes', zh: '隨筆' },
};
const pilierLabel = pilierLabels[pilier]?.[lang] ?? pilier;
const pilierPath = getLocalePath(lang, `/analyses/${pilier}/`);
const analysesPath = getLocalePath(lang, '/analyses/');

const articleMeta = {
	publishedTime: pubDate ? new Date(pubDate).toISOString() : undefined,
	modifiedTime: updatedDate ? new Date(updatedDate).toISOString() : undefined,
	section: pilierLabel,
	tags,
};

const inLanguage = lang === 'fr' ? 'fr-FR' : lang === 'zh' ? 'zh-Hant' : 'en-US';
const published = pubDate ? new Date(pubDate).toISOString() : undefined;
const modified = updatedDate ? new Date(updatedDate).toISOString() : published;

const newsArticleSchema = {
	"@context": "https://schema.org",
	"@type": "NewsArticle",
	"headline": title,
	"description": description,
	"author": { "@type": "Person", "@id": "https://romainblachier.fr/#person", "name": "Romain Blachier" },
	"publisher": { "@type": "Person", "@id": "https://romainblachier.fr/#person", "name": "Romain Blachier" },
	"datePublished": published,
	"dateModified": modified,
	"mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.toString() },
	"articleSection": pilierLabel,
	"keywords": tags.join(', '),
	"inLanguage": inLanguage,
	"isAccessibleForFree": true,
};
---

<html lang={htmlLang}>
	<head>
		<BaseHead title={`${title} | Romain Blachier`} description={description} article={articleMeta} />
		<style>
			main { width: calc(100% - 2em); max-width: 100%; margin: 0; }
			.hero-image { width: 100%; }
			.hero-image img { display: block; margin: 0 auto; border-radius: 12px; box-shadow: var(--box-shadow); }
			.prose { width: 720px; max-width: calc(100% - 2em); margin: auto; padding: 1em; color: rgb(var(--gray-dark)); }
			.breadcrumb { width: 720px; max-width: calc(100% - 2em); margin: 1.5em auto 0; font-size: 0.85rem; color: rgb(var(--gray)); }
			.breadcrumb a { color: rgb(var(--gray)); }
			.title { margin-bottom: 1em; padding: 1em 0; text-align: center; line-height: 1; }
			.title h1 { margin: 0 0 0.5em 0; }
			.chapo { font-size: 1.15rem; color: rgb(var(--gray)); font-weight: 500; text-align: center; max-width: 640px; margin: 0 auto 1em; }
			.date { margin-bottom: 0.5em; color: rgb(var(--gray)); }
			.last-updated-on { font-style: italic; }
			.tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; margin-top: 0.5em; }
			.tags span { font-size: 0.75rem; background: rgba(var(--gray-light), 0.7); padding: 0.15em 0.6em; border-radius: 999px; }
		</style>
	</head>
	<body>
		<script type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />
		<Header />
		<main>
			<nav class="breadcrumb" aria-label="breadcrumb">
				<a href={analysesPath}>{t('nav.analyses')}</a> › <a href={pilierPath}>{pilierLabel}</a>
			</nav>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} lang={lang} />
							{updatedDate && (
								<div class="last-updated-on">
									{t('blog.updated')} <FormattedDate date={updatedDate} lang={lang} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
						{chapo && <p class="chapo">{chapo}</p>}
						{tags.length > 0 && <div class="tags">{tags.map((tg) => <span>{tg}</span>)}</div>}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
