---
import { getLangFromUrl } from "../i18n/utils";

interface Props {
	date: Date;
	lang?: string;
}

const { date, lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);
const locale = lang === 'fr' ? 'fr-FR' : lang === 'zh' ? 'zh-Hant' : 'en-US';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
