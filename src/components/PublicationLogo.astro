---
import type { ImageMetadata } from 'astro';

interface Props {
	mediaSlug: string;
	media: string;
}
const { mediaSlug, media } = Astro.props;

// Eagerly resolve every asset so we can pick a logo by filename at build time.
const files = import.meta.glob<ImageMetadata>('../assets/*', { eager: true, import: 'default' });

const logoFile: Record<string, string> = {
	'afp-factuel': 'afp-factuel-logo.svg',
	commonwealth: 'commonwealth-magazine-logo.svg',
	'cw-opinion': 'cw-opinion-logo.svg',
	'revue-conflits': 'revue-conflits-logo.jpg',
	'jean-jaures': 'fondation-jean-jaures-logo.svg',
	'le-vif': 'le-vif-logo.svg',
	'le-temps': 'le-temps-logo.jpg',
	'new-bloom': 'new-bloom-logo.png',
	'terra-nova': 'terra-nova-logo.svg',
	'taipei-times': 'taipei-times-logo.gif',
	'global-taiwan-institute': 'global-taiwan-institute-logo.png',
	'taiwan-insight': 'university-of-nottingham-logo.svg',
	udn: 'united-daily-news-logo.png',
	'liberty-times': 'liberty-times-logo.svg',
	telos: 'telos-eu-logo.png',
	ceias: 'ceias-logo.svg',
	rti: 'rti-logo.svg',
	'samoa-observer': 'samoa-observer-logo.svg',
	'slate-fr': 'slate-fr-logo.png',
	'cameroun-actuel': 'cameroun-actuel-logo.svg',
	'defis-actuels': 'defis-actuels-logo.svg',
	ecomatin: 'ecomatin-logo.svg',
	'journal-du-cameroun': 'journal-du-cameroun-logo.png',
	'tribune-eco': 'tribune-eco-logo.png',
	'coeur-d-afrique': 'coeur-d-afrique-logo.png',
	huffpost: 'huffpost-logo.svg',
	liberation: 'liberation-logo.svg',
	'lyon-mag': 'lyon-mag-logo.svg',
	'rue89-lyon': 'rue89-lyon-logo.svg',
	'le-monde': 'le-monde-logo.svg',
	marianne: 'marianne-logo.svg',
	'african-arguments': 'african-arguments-logo.svg',
	hespress: 'hespress-logo.jpg',
	// asia-times: no asset → monogram fallback
};

// Secondary logo shown alongside the primary (e.g. Terra Nova + La Grande Conversation).
const secondLogoFile: Record<string, string> = {
	'terra-nova': 'la-grande-conversation-logo.svg',
};

const filename = logoFile[mediaSlug];
const asset = filename ? files[`../assets/${filename}`] : undefined;

const secondFilename = secondLogoFile[mediaSlug];
const secondAsset = secondFilename ? files[`../assets/${secondFilename}`] : undefined;

// Wordmarks much wider than tall (Taipei Times, Cœur d'Afrique, Journal du Cameroun…)
// shrink to a few pixels in a 44 px square. They get a wider pill instead: same
// height, width following the logo's ratio, capped at WIDE_MAX. --logo-w carries
// that width so a context with its own sizing (home cards) can ignore it.
const WIDE_RATIO = 1.8;
const WIDE_MAX = 132;
const pill = (a: ImageMetadata | undefined, inner: number) => {
	const ratio = a && a.height ? a.width / a.height : 1;
	return ratio >= WIDE_RATIO ? Math.min(WIDE_MAX, Math.round(inner * ratio + 18)) : undefined;
};
const wideW = pill(asset, 32);
const pairW = [pill(asset, 24), pill(secondAsset, 24)];

// Fallback monogram from the outlet name (e.g. "Asia Times" → "AT").
const monogram = media
	.replace(/[^\p{L}\s]/gu, ' ')
	.trim()
	.split(/\s+/)
	.slice(0, 2)
	.map((w) => w[0])
	.join('')
	.toUpperCase();
---

{
	secondAsset ? (
		<div class="pub-logo-pair" role="img" aria-label={media}>
			{asset && <img class:list={['pub-logo pub-logo--sm', { 'pub-logo--wide': pairW[0] }]} style={pairW[0] && `--logo-w: ${pairW[0]}px`} src={asset.src} alt="" loading="lazy" decoding="async" />}
			<img class:list={['pub-logo pub-logo--sm', { 'pub-logo--wide': pairW[1] }]} style={pairW[1] && `--logo-w: ${pairW[1]}px`} src={secondAsset.src} alt="" loading="lazy" decoding="async" />
		</div>
	) : asset ? (
		<img class:list={['pub-logo', { 'pub-logo--wide': wideW }]} style={wideW && `--logo-w: ${wideW}px`} src={asset.src} alt={media} width={wideW ?? 44} height="44" loading="lazy" decoding="async" />
	) : (
		<span class="pub-logo pub-logo--mono" aria-hidden="true">{monogram}</span>
	)
}

<style>
	.pub-logo {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		object-fit: contain;
		border-radius: 8px;
		background: white;
		border: 1px solid rgba(var(--gray-light), 0.9);
		padding: 4px;
	}
	.pub-logo--mono {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-weight: 700;
		font-size: 0.95rem;
		color: rgb(var(--gray-dark));
		background: rgba(var(--gray-light), 0.7);
	}
	.pub-logo-pair {
		display: flex;
		flex-direction: column;
		gap: 4px;
		flex-shrink: 0;
	}
	.pub-logo--sm {
		width: 44px;
		height: 36px;
	}
	.pub-logo--wide {
		width: var(--logo-w);
		padding: 5px 8px;
	}
	.pub-logo--sm.pub-logo--wide { padding: 4px 8px }
</style>
