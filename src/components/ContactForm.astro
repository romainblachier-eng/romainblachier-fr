---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	lang?: 'fr' | 'en' | 'zh';
	variant?: 'dark' | 'light';
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const variant = Astro.props.variant || 'dark';
---

<form
	class:list={['contact-form', variant === 'light' && 'contact-form--light']}
	id="contact-form"
	action="https://formsubmit.co/ajax/4b15693e7a47a940348f4848f483bf9e"
	method="POST"
	data-captcha-label={t('contact.captcha')}
	data-captcha-wrong={t('contact.captcha.wrong')}
	data-sending={t('contact.sending')}
	data-sent={t('contact.sent')}
	data-send={`${t('contact.send')} →`}
>
	<input type="hidden" name="_captcha" value="false" />
	<input type="hidden" name="_subject" value="[romainblachier.fr] Nouveau message" />
	<input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;border:0;padding:0" />
	<div class="form-row">
		<input type="text" name="name" placeholder={t('contact.name')} required />
		<input type="email" name="email" placeholder={t('contact.email')} required />
	</div>
	<input type="text" name="subject" placeholder={t('contact.subject')} required />
	<textarea name="message" placeholder={t('contact.message')} required></textarea>
	<div class="captcha-row" id="captcha-row">
		<label id="captcha-label"></label>
		<input type="text" id="captcha-input" placeholder={t('contact.captcha.placeholder')} required autocomplete="off" />
	</div>
	<button type="submit" id="contact-submit">{t('contact.send')} →</button>
	<div id="contact-success" class="form-feedback" style="display:none">
		{t('contact.success')}
	</div>
	<div id="contact-error" class="form-feedback form-feedback--error" style="display:none">
		{t('contact.error')}
		<a href="mailto:romain.blachier@gmail.com">romain.blachier@gmail.com</a>.
	</div>
</form>

<script>
	(function () {
		const form = document.getElementById('contact-form') as HTMLFormElement;
		if (!form) return;
		const ds = form.dataset;
		const a = Math.floor(Math.random() * 10) + 1;
		const b = Math.floor(Math.random() * 10) + 1;
		const answer = a + b;
		document.getElementById('captcha-label')!.textContent =
			(ds.captchaLabel || '').replace('{a}', String(a)).replace('{b}', String(b));
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const input = document.getElementById('captcha-input') as HTMLInputElement;
			if (parseInt(input.value, 10) !== answer) {
				input.style.borderColor = '#f87171';
				input.value = '';
				input.placeholder = ds.captchaWrong || '';
				return;
			}
			const btn = document.getElementById('contact-submit') as HTMLButtonElement;
			const success = document.getElementById('contact-success')!;
			const error = document.getElementById('contact-error')!;
			btn.disabled = true;
			btn.textContent = ds.sending || '';
			success.style.display = 'none';
			error.style.display = 'none';
			try {
				const data = Object.fromEntries(new FormData(form));
				delete data['_captcha'];
				const res = await fetch(form.action, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
					body: JSON.stringify(data)
				});
				const body = await res.json().catch(() => null);
				// FormSubmit renvoie HTTP 200 même en cas de refus : il faut lire le flag success.
				const accepted = res.ok && body && String(body.success) === 'true';
				if (accepted) {
					form.reset();
					success.style.display = 'block';
					btn.textContent = ds.sent || '';
				} else { throw new Error(String(res.status)); }
			} catch {
				error.style.display = 'block';
				btn.textContent = ds.send || '';
				btn.disabled = false;
			}
		});
	})();
</script>
