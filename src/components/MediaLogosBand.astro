---
import { Image } from 'astro:assets';
import taipeiTimesLogo from '../assets/taipei-times-logo.gif';
import commonwealthLogo from '../assets/commonwealth-magazine-logo.svg';
import telosLogo from '../assets/telos-eu-logo.png';
import jaurasLogo from '../assets/fondation-jean-jaures-logo.svg';
import leTempsLogo from '../assets/le-temps-logo.jpg';
import leVifLogo from '../assets/le-vif-logo.svg';
import newBloomLogo from '../assets/new-bloom-logo.png';
import conflitsLogo from '../assets/revue-conflits-logo.jpg';
import grandeConvLogo from '../assets/la-grande-conversation-logo.png';
import nottinghamLogo from '../assets/university-of-nottingham-logo.svg';

const logos = [
	{ src: taipeiTimesLogo, alt: 'Taipei Times', width: 120, height: 40 },
	{ src: commonwealthLogo, alt: 'CommonWealth Magazine', width: 40, height: 40 },
	{ src: telosLogo, alt: 'Telos', width: 100, height: 40 },
	{ src: jaurasLogo, alt: 'Fondation Jean-Jaurès', width: 120, height: 40 },
	{ src: leTempsLogo, alt: 'Le Temps', width: 100, height: 40 },
	{ src: leVifLogo, alt: 'Le Vif', width: 80, height: 40 },
	{ src: newBloomLogo, alt: 'New Bloom Magazine', width: 100, height: 40 },
	{ src: conflitsLogo, alt: 'Revue Conflits', width: 100, height: 40 },
	{ src: grandeConvLogo, alt: 'Terra Nova — La Grande Conversation', width: 120, height: 40 },
	{ src: nottinghamLogo, alt: 'University of Nottingham — Taiwan Insight', width: 100, height: 40 },
];
---

<div class="media-logos-band">
	<div class="media-logos-inner">
		{logos.map((logo) => (
			<div class="media-logo-item">
				<Image src={logo.src} alt={logo.alt} width={logo.width} height={40} />
			</div>
		))}
	</div>
</div>
