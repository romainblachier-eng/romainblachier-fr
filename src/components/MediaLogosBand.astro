---
import { Image } from 'astro:assets';
import taipeiTimesLogo from '../assets/taipei-times-logo.gif';
import commonwealthLogo from '../assets/commonwealth-magazine-logo.svg';
import telosLogo from '../assets/telos-eu-logo.png';
import jaurasLogo from '../assets/fondation-jean-jaures-logo.svg';
import leTempsLogo from '../assets/le-temps-logo.jpg';
import leVifLogo from '../assets/le-vif-logo.svg';
import newBloomLogo from '../assets/new-bloom-logo.png';
import conflitsLogo from '../assets/revue-conflits-logo.jpg';
import grandeConvLogo from '../assets/la-grande-conversation-logo.png';
import nottinghamLogo from '../assets/university-of-nottingham-logo.svg';
import udnLogo from '../assets/united-daily-news-logo.png';
import libertyTimesLogo from '../assets/liberty-times-logo.svg';
import rtiLogo from '../assets/rti-logo.svg';
import samoaObserverLogo from '../assets/samoa-observer-logo.svg';
import slateFrLogo from '../assets/slate-fr-logo.png';
import camerounActuelLogo from '../assets/cameroun-actuel-logo.svg';
import huffpostLogo from '../assets/huffpost-logo.svg';
import liberationLogo from '../assets/liberation-logo.svg';
import lyonMagLogo from '../assets/lyon-mag-logo.svg';
import rue89LyonLogo from '../assets/rue89-lyon-logo.svg';
import leMondeLogo from '../assets/le-monde-logo.svg';
import marianneLogo from '../assets/marianne-logo.svg';

const logos = [
	{ src: taipeiTimesLogo, alt: 'Taipei Times', width: 320, height: 40, wide: true },
	{ src: rtiLogo, alt: 'Radio Taiwan International', width: 40, height: 40 },
	{ src: udnLogo, alt: '聯合報 — United Daily News', width: 67, height: 40 },
	{ src: libertyTimesLogo, alt: '自由時報 — Liberty Times', width: 40, height: 40 },
	{ src: commonwealthLogo, alt: 'CommonWealth Magazine', width: 40, height: 40 },
	{ src: telosLogo, alt: 'Telos', width: 100, height: 40 },
	{ src: jaurasLogo, alt: 'Fondation Jean-Jaurès', width: 120, height: 40 },
	{ src: leTempsLogo, alt: 'Le Temps', width: 100, height: 40 },
	{ src: leVifLogo, alt: 'Le Vif', width: 80, height: 40 },
	{ src: newBloomLogo, alt: 'New Bloom Magazine', width: 100, height: 40 },
	{ src: conflitsLogo, alt: 'Revue Conflits', width: 100, height: 40 },
	{ src: grandeConvLogo, alt: 'Terra Nova — La Grande Conversation', width: 120, height: 40 },
	{ src: nottinghamLogo, alt: 'University of Nottingham — Taiwan Insight', width: 100, height: 40 },
	{ src: samoaObserverLogo, alt: 'Samoa Observer', width: 200, height: 40, wide: true },
	{ src: slateFrLogo, alt: 'Slate.fr', width: 107, height: 40 },
	{ src: camerounActuelLogo, alt: 'Cameroun Actuel', width: 140, height: 40 },
	{ src: huffpostLogo, alt: 'Le HuffPost', width: 180, height: 40, wide: true },
	{ src: liberationLogo, alt: 'Libération', width: 180, height: 40, wide: true },
	{ src: lyonMagLogo, alt: 'Lyon Mag', width: 140, height: 40 },
	{ src: rue89LyonLogo, alt: 'Rue89 Lyon', width: 160, height: 40 },
	{ src: leMondeLogo, alt: 'Le Monde', width: 174, height: 40 },
	{ src: marianneLogo, alt: 'Marianne', width: 180, height: 40, wide: true },
];
---

<div class="media-logos-band">
	<div class="media-logos-inner">
		{logos.map((logo) => (
			<div class:list={['media-logo-item', { 'media-logo-item--wide': logo.wide }]}>
				<Image src={logo.src} alt={logo.alt} width={logo.width} height={40} />
			</div>
		))}
	</div>
</div>
