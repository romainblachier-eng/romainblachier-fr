---
import { Image } from 'astro:assets';
import poster from '../assets/conference-france-taiwan-2026.png';

interface Props {
	lang: 'fr' | 'en' | 'zh';
}

const { lang } = Astro.props;
// Date and venue: MEDEF International reminder of 9 September 2026.
// Speaking slot and session: the organiser's confirmation and supplied agenda.
const copy = {
	fr: {
		date: '10 septembre 2026',
		city: 'Paris',
		title: 'Sécurité énergétique et géopolitique',
		conference: '28e conférence France–Taïwan de coopération économique',
		text: 'J’interviendrai aux côtés de Kuan-Shen Chiang, du département des combustibles de Taipower.',
		organisers: 'Organisée par MEDEF International et la CIECA.',
		time: '11 h 10–11 h 25 · en anglais',
		language: 'Heure de Paris',
		venue: 'Cercle de l’Union interalliée, Paris',
		link: 'Informations sur la conférence',
		posterAlt: 'Affiche de la conférence France–Taïwan du 10 septembre 2026 à Paris : intervention de Romain Blachier sur la sécurité énergétique et la géopolitique.',
		posterLink: 'Agrandir l’affiche',
	},
	en: {
		date: '10 September 2026',
		city: 'Paris',
		title: 'Energy security and geopolitics',
		conference: '28th France–Taiwan Economic Cooperation Conference',
		text: 'I will be speaking alongside Kuan-Shen Chiang, from Taipower’s Department of Fuels.',
		organisers: 'Organised by MEDEF International and CIECA.',
		time: '11:10–11:25 · in English',
		language: 'Paris time',
		venue: 'Cercle de l’Union interalliée, Paris',
		link: 'Conference information',
		posterAlt: 'French-language poster for the France–Taiwan conference on 10 September 2026 in Paris, featuring Romain Blachier’s talk on energy security and geopolitics.',
		posterLink: 'View the full poster (in French)',
	},
	zh: {
		date: '2026年9月10日',
		city: '巴黎',
		title: '能源安全與地緣政治',
		conference: '第28屆臺法經濟合作會議',
		text: '我將與台灣電力公司燃料處蔣光聲副處長共同參與這場會議，發表演講。',
		organisers: '由 MEDEF International 與 CIECA 共同主辦。',
		time: '11:10–11:25 · 英語演講',
		language: '巴黎時間',
		venue: 'Cercle de l’Union interalliée，巴黎',
		link: '會議資訊',
		posterAlt: '2026年9月10日於巴黎舉行的臺法經濟合作會議法文海報：Romain Blachier 將就能源安全與地緣政治發表演講。',
		posterLink: '放大海報（法文）',
	},
}[lang];
const eventUrl = 'https://event.medefinternational.fr/28eme-conference-france-taiwan-de-cooperation-economique-g520';
---

<section class="conference-announcement" id="conference-france-taiwan" aria-labelledby="conference-title">
	<div class="conference-inner">
		<a class="conference-poster" href={poster.src} target="_blank" rel="noopener noreferrer">
			<Image
				src={poster}
				alt={copy.posterAlt}
				widths={[360, 720, 1080]}
				sizes="(max-width: 700px) min(100vw - 48px, 360px), (max-width: 1000px) 300px, 360px"
				format="webp"
				quality={85}
				loading="lazy"
			/>
			<span>{copy.posterLink} <span aria-hidden="true">↗</span></span>
		</a>
		<div class="conference-content">
			<p class="conference-dateline"><time datetime="2026-09-10">{copy.date}</time> · {copy.city}</p>
			<h2 id="conference-title">{copy.title}</h2>
			<p class="conference-description">{copy.text}</p>
			<div class="conference-context">
				<p class="conference-name">{copy.conference}</p>
				<p>{copy.organisers}</p>
			</div>
			<div class="conference-details">
				<p>{copy.venue}</p>
				<p>{copy.time} <span>({copy.language})</span></p>
			</div>
			<a class="conference-link" href={eventUrl} target="_blank" rel="noopener noreferrer">
				{copy.link} <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</section>

<style>
	.conference-announcement {
		padding: 3.5rem 2rem;
		background: var(--bg-alt);
		color: var(--ink);
		scroll-margin-top: 5rem;
	}
	.conference-inner {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 360px minmax(0, 1fr);
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
	}
	.conference-poster { display: block; text-decoration: none; }
	.conference-poster img { display: block; width: 100%; height: auto; }
	.conference-poster > span {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 44px;
		font-size: .8rem;
		color: var(--text);
	}
	.conference-dateline { font-size: .9rem; font-weight: 500; }
	h2 {
		margin-top: .85rem;
		max-width: 19ch;
		font-size: clamp(1.9rem, 3.1vw, 2.65rem);
		line-height: 1.18;
		font-weight: 500;
	}
	.conference-description { margin-top: 1.4rem; max-width: 48ch; font-size: 1.05rem; line-height: 1.75; }
	.conference-context { margin-top: 1.4rem; padding-top: 1.2rem; border-top: 1px solid #d2d5d5; font-size: .9rem; line-height: 1.65; }
	.conference-name { font-weight: 600; }
	.conference-context > p + p { margin-top: .2rem; }
	.conference-details { margin-top: 1rem; font-size: .85rem; line-height: 1.8; }
	.conference-details span { white-space: nowrap; }
	.conference-link {
		display: inline-flex;
		align-items: center;
		gap: .75rem;
		min-height: 44px;
		margin-top: .85rem;
		font-size: .9rem;
		font-weight: 500;
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
	}
	.conference-link:hover,
	.conference-poster:hover > span { color: #734837; }
	.conference-poster:focus-visible,
	.conference-link:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
	@media (min-width: 701px) and (max-width: 1000px) {
		.conference-inner { grid-template-columns: 300px minmax(0, 1fr); gap: 2rem; }
	}
	@media (max-width: 700px) {
		.conference-announcement { padding: 2rem 1.5rem; scroll-margin-top: 9rem; }
		.conference-inner { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
		.conference-poster { width: 100%; max-width: 360px; justify-self: center; }
		h2 { max-width: 22ch; font-size: 2rem; }
		.conference-description { font-size: 1rem; margin-top: 1rem; }
		.conference-context { font-size: 1rem; }
		.conference-details { font-size: 1rem; }
		.conference-link { font-size: 1rem; }
	}
</style>
