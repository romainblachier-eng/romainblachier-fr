---
import HeaderLink from "./HeaderLink.astro";
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === 'fr' ? 'en' : 'fr';

const pathname = Astro.url.pathname;
let otherLangPath: string;
if (lang === 'fr') {
	otherLangPath = `/en${pathname === '/' ? '/' : pathname}`;
} else {
	otherLangPath = pathname.replace(/^\/en/, '') || '/';
}
---

<header>
	<nav>
		<a href={getLocalePath(lang, '/')} class="site-brand">Romain Blachier</a>
		<div class="internal-links">
			<HeaderLink href={getLocalePath(lang, '/')}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/travaux')}>{t('nav.travaux')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/blog')}>{t('nav.blog')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/') + '#contact'}>{t('nav.contact')}</HeaderLink>
			<a href={otherLangPath} class="lang-switch" aria-label={otherLang === 'en' ? 'Switch to English' : 'Passer en français'}>
				{otherLang === 'en' ? 'EN' : 'FR'}
			</a>
		</div>
	</nav>
</header>
