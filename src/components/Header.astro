---
import HeaderLink from "./HeaderLink.astro";
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pathname = Astro.url.pathname;
// Strip any locale prefix to obtain the "bare" path shared across languages.
const bare = pathname.replace(/^\/(en|zh)(?=\/|$)/, "") || "/";
const localized = (code: string) =>
	code === "fr"
		? bare === "/" ? "/" : bare
		: `/${code}${bare === "/" ? "/" : bare}`;

const langLinks = [
	{ code: "fr", short: "FR", name: "Français", aria: "Passer en français" },
	{ code: "en", short: "EN", name: "English", aria: "Switch to English" },
	{ code: "zh", short: "中", name: "繁體中文", aria: "切換為繁體中文" },
];
const current = langLinks.find((l) => l.code === lang) ?? langLinks[0];
---

<header>
	<nav>
		<a href={getLocalePath(lang, '/')} class="site-brand">Romain Blachier</a>
		<div class="internal-links">
			<HeaderLink href={getLocalePath(lang, '/')}>{t('nav.home')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/analyses')}>{t('nav.analyses')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/publications')}>{t('nav.publications')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/travaux')}>{t('nav.travaux')}</HeaderLink>
			<HeaderLink href={getLocalePath(lang, '/contact')}>{t('nav.contact')}</HeaderLink>
			<details class="lang-dd">
				<summary class="lang-dd-toggle" aria-label="Language · Langue · 語言">
					<span class="lang-dd-globe" aria-hidden="true">🌐</span><span class="lang-dd-current">{current.short}</span><span class="lang-dd-caret" aria-hidden="true">▾</span>
				</summary>
				<ul class="lang-dd-menu">
					{langLinks.map((l) => (
						<li>
							<a
								href={localized(l.code)}
								data-lang={l.code}
								class={l.code === lang ? 'active' : ''}
								aria-current={l.code === lang ? 'true' : undefined}
								aria-label={l.aria}
							>{l.name}</a>
						</li>
					))}
				</ul>
			</details>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		// Remember the visitor's explicit language choice so auto-detection
		// (see BaseHead) never overrides it on later visits.
		document.querySelectorAll('.lang-dd a[data-lang]').forEach(function (el) {
			el.addEventListener('click', function () {
				try { localStorage.setItem('preferred-lang', el.getAttribute('data-lang')); } catch (e) {}
			});
		});
		// Close the dropdown when clicking outside it.
		document.addEventListener('click', function (e) {
			document.querySelectorAll('details.lang-dd[open]').forEach(function (d) {
				if (!d.contains(e.target)) d.removeAttribute('open');
			});
		});
	})();
</script>
