---
import HeaderLink from "./HeaderLink.astro";
import { getLangFromUrl, useTranslations, getLocalePath } from "../i18n/utils";
import { routePath, localizedRoutes, type RouteKey } from "../i18n/routes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Conseil and Presse have no Chinese version yet: routePath returns undefined and
// the link is simply not rendered, rather than pointing at a 404.
const conseilHref = routePath('conseil', lang);
const presseHref = routePath('presse', lang);

const pathname = Astro.url.pathname;
// Strip any locale prefix to obtain the "bare" path shared across languages.
const bare = pathname.replace(/^\/(en|zh)(?=\/|$)/, "") || "/";

// Pages whose slug differs across locales, or that only exist in some of them:
// the switcher must follow the route map instead of reusing the current path.
// Without a counterpart, it falls back to that language's home page.
const currentRoute = (Object.keys(localizedRoutes) as RouteKey[]).find((key) =>
	Object.values(localizedRoutes[key]).some((p) => p.replace(/\/$/, "") === pathname.replace(/\/$/, "")),
);
const localized = (code: string) => {
	if (currentRoute) {
		return routePath(currentRoute, code as typeof lang) ?? (code === "fr" ? "/" : `/${code}/`);
	}
	return code === "fr"
		? bare === "/" ? "/" : bare
		: `/${code}${bare === "/" ? "/" : bare}`;
};

const langLinks = [
	{ code: "fr", short: "FR", name: "Français", aria: "Passer en français" },
	{ code: "en", short: "EN", name: "English", aria: "Switch to English" },
	{ code: "zh", short: "中", name: "繁體中文", aria: "切換為繁體中文" },
];
const current = langLinks.find((l) => l.code === lang) ?? langLinks[0];
---

<header>
	<nav>
		<a href={getLocalePath(lang, '/')} class="site-brand">Romain Blachier</a>
		<div class="internal-links">
			<HeaderLink href={getLocalePath(lang, '/')}>{t('nav.home')}</HeaderLink>
			{conseilHref && <HeaderLink href={conseilHref}>{t('nav.consulting')}</HeaderLink>}
			<HeaderLink href={getLocalePath(lang, '/publications')}>{t('nav.publications')}</HeaderLink>
			{presseHref && <HeaderLink href={presseHref}>{t('nav.press')}</HeaderLink>}
			<HeaderLink href={getLocalePath(lang, '/contact')}>{t('nav.contact')}</HeaderLink>
			<details class="lang-dd">
				<summary class="lang-dd-toggle" aria-label="Language · Langue · 語言">
					<svg class="lang-dd-globe" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.2 2.5 3.3 5.5 3.3 9s-1.1 6.5-3.3 9c-2.2-2.5-3.3-5.5-3.3-9S9.8 5.5 12 3Z"/></svg><span class="lang-dd-current">{current.short}</span><span class="lang-dd-caret" aria-hidden="true">⌄</span>
				</summary>
				<ul class="lang-dd-menu">
					{langLinks.map((l) => (
						<li>
							<a
								href={localized(l.code)}
								data-lang={l.code}
								class={l.code === lang ? 'active' : ''}
								aria-current={l.code === lang ? 'true' : undefined}
								aria-label={l.aria}
							>{l.name}</a>
						</li>
					))}
				</ul>
			</details>
		</div>
	</nav>
</header>

<script is:inline>
	(function () {
		// Remember the visitor's explicit language choice so auto-detection
		// (see BaseHead) never overrides it on later visits.
		document.querySelectorAll('.lang-dd a[data-lang]').forEach(function (el) {
			el.addEventListener('click', function () {
				try { localStorage.setItem('preferred-lang', el.getAttribute('data-lang')); } catch (e) {}
			});
		});
		// Close the dropdown when clicking outside it.
		document.addEventListener('click', function (e) {
			document.querySelectorAll('details.lang-dd[open]').forEach(function (d) {
				if (!d.contains(e.target)) d.removeAttribute('open');
			});
		});
	})();
</script>
