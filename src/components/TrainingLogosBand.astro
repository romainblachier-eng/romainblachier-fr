---
import type { ImageMetadata } from 'astro';

interface Props {
	heading: string;
}
const { heading } = Astro.props;

// Resolve any asset by filename at build time; logos appear automatically once
// the corresponding file is added to src/assets/.
const files = import.meta.glob<ImageMetadata>('../assets/*', { eager: true, import: 'default' });
const exts = ['svg', 'png', 'jpg', 'jpeg', 'webp', 'gif'];

const institutions = [
	{ slug: 'ensap-formation', name: 'ENSAP Formation', url: 'https://www.ensap.fr/' },
	{ slug: 'cnfpt', name: 'CNFPT', url: 'https://www.cnfpt.fr/' },
	{ slug: 'lefebvre-dalloz', name: 'Lefebvre Dalloz', url: 'https://www.lefebvre-dalloz.fr/' },
];

const resolve = (slug: string) => {
	for (const ext of exts) {
		const hit = files[`../assets/${slug}-logo.${ext}`];
		if (hit) return hit;
	}
	return undefined;
};

const items = institutions.map((i) => ({ ...i, asset: resolve(i.slug) }));
---

<div class="training-band">
	<p class="training-band-heading">{heading}</p>
	<div class="training-band-inner">
		{items.map((i) => (
			<a class="training-logo-item" href={i.url} target="_blank" rel="noopener noreferrer" aria-label={i.name}>
				{i.asset ? (
					<img src={i.asset.src} alt={i.name} height="44" loading="lazy" decoding="async" />
				) : (
					<span class="training-wordmark">{i.name}</span>
				)}
			</a>
		))}
	</div>
</div>

<style>
	.training-band {
		text-align: center;
		margin: 2.5rem auto 0;
	}
	/* Intertitre en serif italique, comme les autres chapeaux de la page. */
	.training-band-heading {
		font-family: var(--display);
		font-style: italic;
		font-size: .95rem;
		color: var(--muted);
		letter-spacing: 0;
		text-transform: none;
		margin-bottom: .85rem;
	}
	.training-band-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: .5rem 2rem;
	}
	.training-logo-item {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.training-logo-item img {
		width: auto;
		height: 44px;
		object-fit: contain;
		opacity: .85;
		transition: opacity .2s ease;
	}
	.training-logo-item:hover img { opacity: 1 }
	/* Repli quand aucun fichier logo n'est fourni : simple libellé, pas de pastille. */
	.training-wordmark {
		font-size: 1rem;
		font-weight: 500;
		color: var(--ink);
		border-bottom: 1px solid var(--faint);
		padding-bottom: 1px;
		transition: border-color .15s;
	}
	.training-logo-item:hover .training-wordmark { border-color: var(--ink) }
</style>
