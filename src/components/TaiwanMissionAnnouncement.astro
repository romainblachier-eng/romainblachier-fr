---
interface Props {
	lang: 'fr' | 'en' | 'zh';
	// 'strip' : barre fine sous l'en-tête, visible sans défiler, qui renvoie à la section.
	variant?: 'section' | 'strip';
}

const { lang, variant = 'section' } = Astro.props;
// Mission du 23 octobre au 1er novembre 2026 : à retirer ou à passer au passé après le 1er novembre.
// Sources : annonce rédigée par Romain Blachier (22 octobre 2026) ; dates de Kinmen (25-26 octobre),
// nom du groupe (« politique et économique ») et réception du 28 octobre : échanges avec le MOFA.
// Chiffres : tribune Taipei Times du 21 octobre 2026.
const copy = {
	fr: {
		strip: 'Du 23 octobre au 1er novembre, je suis à Taïwan à l’invitation du ministère des Affaires étrangères.',
		stripLink: 'Énergie, Kinmen, rencontres',
		label: 'Mission à Taïwan',
		dateline: 'Taipei et Kinmen · 23 octobre – 1er novembre 2026',
		title: 'Invité à Taïwan par le ministère des Affaires étrangères',
		lead: 'Du 25 au 30 octobre, je fais partie de la Délégation de leaders d’opinion européens et de chercheurs reçue par le ministère : quatorze personnalités venues de toute l’Europe. J’appartiens à son groupe politique et économique. C’est ma troisième invitation à ce titre.',
		kinmen: 'Le programme s’ouvre à Kinmen, archipel taïwanais situé à une dizaine de kilomètres de Xiamen et à 187 kilomètres des côtes de l’île de Taïwan. Mon prochain article de recherche, accepté par la revue Flux, porte sur son approvisionnement électrique.',
		research: 'J’arrive dès le 23 octobre et repars le 1er novembre, pour rencontrer en marge du programme des chercheuses et chercheurs et des responsables du secteur de l’énergie.',
		contact: 'Me proposer une rencontre à Taipei',
		energyTitle: 'L’énergie de Taïwan',
		stats: [
			{ value: '≈ 95 %', label: 'de son énergie importée en 2025' },
			{ value: '≈ ½', label: 'de son électricité produite au gaz' },
			{ value: '11 jours', label: 'de stocks de GNL imposés par la loi' },
		],
		energyNote: 'Dans le Taipei Times du 21 octobre, je plaide pour une réserve stratégique inscrite au budget national et pour un travail commun avec les opérateurs européens de réseaux et de stockage de gaz.',
		energyLink: 'Lire la tribune',
		programmeTitle: 'Au programme',
		programme: [
			{ date: '25-26 oct.', text: 'Kinmen' },
			{ date: '27 oct.', text: 'Forum « La technologie fiable et démocratique » : coopération entre Taïwan et l’Europe dans l’intelligence artificielle et les drones' },
			{ date: '28 oct.', text: 'Réception par le vice-ministre des Affaires étrangères François Wu (吳志中), ancien représentant de Taïwan en France' },
		],
	},
	en: {
		strip: 'From 23 October to 1 November, I am in Taiwan at the invitation of the Ministry of Foreign Affairs.',
		stripLink: 'Energy, Kinmen, meetings',
		label: 'Mission to Taiwan',
		dateline: 'Taipei and Kinmen · 23 October – 1 November 2026',
		title: 'Invited to Taiwan by the Ministry of Foreign Affairs',
		lead: 'From 25 to 30 October, I am part of the European Opinion Leaders Delegation hosted by the Ministry: fourteen opinion leaders and researchers from across Europe. I belong to its political and economic group. This is my third invitation in this capacity.',
		kinmen: 'The programme opens on Kinmen, the Taiwanese archipelago some ten kilometres from Xiamen and 187 kilometres from the coast of Taiwan proper. My next research article, accepted by the journal Flux, deals with its electricity supply.',
		research: 'I arrive on 23 October and leave on 1 November, to meet researchers and energy-sector leaders alongside the official programme.',
		contact: 'Suggest a meeting in Taipei',
		energyTitle: 'Taiwan’s energy',
		stats: [
			{ value: '≈ 95%', label: 'of its energy imported in 2025' },
			{ value: '≈ ½', label: 'of its electricity generated from gas' },
			{ value: '11 days', label: 'of LNG stocks required by law' },
		],
		energyNote: 'In the Taipei Times of 21 October, I argue for a strategic reserve written into the national budget and for joint work with European gas grid and storage operators.',
		energyLink: 'Read the op-ed',
		programmeTitle: 'Programme',
		programme: [
			{ date: '25–26 Oct', text: 'Kinmen' },
			{ date: '27 Oct', text: 'Forum on trustworthy and democratic technology: Taiwan–Europe cooperation in artificial intelligence and drones' },
			{ date: '28 Oct', text: 'Reception by Deputy Foreign Minister François Wu (吳志中), former Taiwanese representative to France' },
		],
	},
	zh: {
		strip: '10 月 23 日至 11 月 1 日，我應外交部邀請訪問台灣。',
		stripLink: '能源、金門、會面',
		label: '訪台行程',
		dateline: '台北、金門 · 2026 年 10 月 23 日至 11 月 1 日',
		title: '應外交部邀請訪問台灣',
		lead: '10 月 25 日至 30 日，我參加外交部接待的歐洲意見領袖訪問團，成員為來自歐洲各地的十四位意見領袖與研究人員。我屬於訪問團的政治經濟組。這是我第三次以此身分受邀訪台。',
		kinmen: '行程從金門開始。金門距廈門約十公里，距台灣本島海岸 187 公里。我的下一篇研究論文已獲期刊《Flux》接受，主題正是金門的電力供應。',
		research: '我 10 月 23 日抵達、11 月 1 日離開，在正式行程之外與研究人員及能源業界人士會面。',
		contact: '在台北與我約見',
		energyTitle: '台灣的能源',
		stats: [
			{ value: '≈ 95%', label: '2025 年能源仰賴進口' },
			{ value: '≈ ½', label: '電力來自天然氣' },
			{ value: '11 天', label: '法定液化天然氣安全存量' },
		],
		energyNote: '我在 10 月 21 日的《台北時報》主張，將戰略儲備編入國家預算，並與歐洲的天然氣輸送及儲存業者合作。',
		energyLink: '閱讀投書',
		programmeTitle: '行程重點',
		programme: [
			{ date: '10/25–26', text: '金門' },
			{ date: '10/27', text: '「可信賴的民主科技」論壇：台灣與歐洲在人工智慧與無人機領域的合作' },
			{ date: '10/28', text: '外交部政務次長吳志中接見。吳次長曾任駐法國代表。' },
		],
	},
}[lang];
const opedUrl = 'https://www.taipeitimes.com/News/editorials/archives/2026/10/21/2003866326';
---

{variant === 'strip' ? (
<aside class="mission-strip" aria-label={copy.label}>
	<p>
		<span class="mission-strip-text">{copy.strip}</span>
		<a href="#mission-taiwan">{copy.stripLink} <span aria-hidden="true">↓</span></a>
	</p>
</aside>
) : (
<section class="mission" id="mission-taiwan" aria-labelledby="mission-title">
	<div class="mission-inner">
		<div class="mission-main">
			<p class="mission-label">{copy.label}</p>
			<p class="mission-dateline">{copy.dateline}</p>
			<h2 id="mission-title">{copy.title}</h2>
			<p class="mission-lead">{copy.lead}</p>
			<p>{copy.kinmen}</p>
			<p>{copy.research}</p>
			<a class="mission-link" href="#contact">{copy.contact} <span aria-hidden="true">→</span></a>
		</div>
		<aside class="mission-side">
			<div class="mission-energy">
				<h3>{copy.energyTitle}</h3>
				<dl class="mission-stats">
					{copy.stats.map((s) => (
						<div><dt>{s.value}</dt><dd>{s.label}</dd></div>
					))}
				</dl>
				<p class="mission-note">{copy.energyNote}</p>
				<a class="mission-link" href={opedUrl} target="_blank" rel="noopener noreferrer">{copy.energyLink} <span aria-hidden="true">↗</span></a>
			</div>
			<div class="mission-programme">
				<h3>{copy.programmeTitle}</h3>
				<ol>
					{copy.programme.map((p) => (
						<li><span class="mission-date">{p.date}</span><span>{p.text}</span></li>
					))}
				</ol>
			</div>
		</aside>
	</div>
</section>
)}

<style>
	.mission-strip {
		background: var(--ink);
		color: #fff;
	}
	.mission-strip p {
		max-width: var(--max);
		margin: 0 auto;
		padding: .7rem 2rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: .25rem 1rem;
		font-size: .9rem;
		line-height: 1.5;
		text-align: center;
	}
	.mission-strip a {
		color: #fff;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}
	.mission-strip a:hover { color: var(--accent-warm); }
	.mission-strip a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
	.mission {
		padding: 3.5rem 2rem;
		background: var(--bg-alt);
		border-top: 3px solid var(--accent-warm);
		border-bottom: 1px solid var(--line);
		color: var(--text);
		scroll-margin-top: 5rem;
	}
	.mission-inner {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}
	.mission-label {
		display: inline-block;
		padding: .25rem .7rem;
		border-radius: 999px;
		background: var(--ink);
		color: #fff;
		font-size: .75rem;
		font-weight: 600;
		letter-spacing: .06em;
		text-transform: uppercase;
	}
	.mission-dateline { margin-top: .9rem; font-size: .9rem; font-weight: 500; color: var(--ink); }
	h2 {
		margin-top: .6rem;
		max-width: 22ch;
		font-size: clamp(1.9rem, 3.1vw, 2.65rem);
		line-height: 1.18;
		font-weight: 500;
		color: var(--ink);
	}
	.mission-main > p:not(.mission-label):not(.mission-dateline) {
		margin-top: 1rem;
		max-width: 60ch;
		font-size: 1rem;
		line-height: 1.75;
	}
	.mission-main > .mission-lead { margin-top: 1.4rem; font-size: 1.08rem; color: var(--ink); }
	.mission-side { display: grid; gap: 1.25rem; }
	.mission-energy,
	.mission-programme {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.4rem 1.5rem;
	}
	h3 {
		font-family: var(--sans);
		font-size: .78rem;
		font-weight: 600;
		letter-spacing: .08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.mission-stats {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.mission-stats dt {
		font-family: var(--display);
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		line-height: 1.1;
		color: var(--ink);
		white-space: nowrap;
	}
	.mission-stats dd { margin-top: .35rem; font-size: .82rem; line-height: 1.45; }
	.mission-note {
		margin-top: 1.1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-size: .9rem;
		line-height: 1.65;
	}
	.mission-programme ol { margin-top: .8rem; list-style: none; padding: 0; }
	.mission-programme li {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: .75rem;
		padding: .6rem 0;
		font-size: .9rem;
		line-height: 1.55;
	}
	.mission-programme li + li { border-top: 1px solid var(--line); }
	.mission-date { font-weight: 600; color: var(--ink); white-space: nowrap; }
	.mission-link {
		display: inline-flex;
		align-items: center;
		gap: .6rem;
		min-height: 44px;
		margin-top: .9rem;
		font-size: .92rem;
		font-weight: 500;
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
	}
	.mission-link:hover { color: #734837; }
	.mission-link:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
	@media (max-width: 900px) {
		.mission-inner { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
	}
	@media (max-width: 700px) {
		.mission-strip p { padding: .6rem 1rem; font-size: .85rem; }
		.mission { padding: 2.25rem 1rem; scroll-margin-top: 9rem; }
		h2 { font-size: 1.9rem; }
		.mission-energy, .mission-programme { padding: 1.2rem 1.1rem; }
		.mission-stats { gap: .75rem; }
		.mission-stats dt { font-size: 1.4rem; }
		.mission-programme li { grid-template-columns: 4.75rem minmax(0, 1fr); }
	}
</style>
