---
interface Props {
	lang: 'fr' | 'en' | 'zh';
	// 'strip' : barre fine sous l'en-tête, visible sans défiler, qui renvoie à la section.
	variant?: 'section' | 'strip';
}

const { lang, variant = 'section' } = Astro.props;
// Mission du 23 octobre au 1er novembre 2026 : à retirer ou à passer au passé après le 1er novembre.
// Contenu volontairement vague à la demande de Romain (26 octobre 2026) : nom officiel de la
// délégation conservé, mais ni programme daté, ni effectif, ni interlocuteur nommé.
// Sources : Romain Blachier (22 et 26 octobre 2026) ; thème drones : forum du programme
// (échanges avec le MOFA). Chiffres : tribune Taipei Times du 21 octobre 2026.
const copy = {
	fr: {
		strip: 'Du 23 octobre au 1er novembre, je suis à Taïwan, sélectionné par le ministère des Affaires étrangères pour sa délégation d’experts et de personnalités européennes.',
		stripLink: 'Énergie, Kinmen, rencontres',
		label: 'Mission à Taïwan',
		dateline: 'Taipei et Kinmen · 23 octobre – 1er novembre 2026',
		title: 'Invité à Taïwan par le ministère des Affaires étrangères',
		lead: 'Le ministère m’a sélectionné pour sa Délégation de leaders d’opinion européens et de chercheurs, qui réunit des experts et des personnalités de toute l’Europe. C’est ma troisième invitation officielle.',
		body: 'Le programme nous conduit auprès de ministres, d’acteurs économiques et de chercheurs taïwanais, jusqu’à Kinmen, l’archipel en première ligne face à Xiamen. Les échanges portent notamment sur la coopération entre Taïwan et l’Europe en matière de drones. J’y porte pour ma part la question de la sécurité énergétique d’une île qui importe la quasi-totalité de son énergie.',
		contact: 'Me proposer une rencontre à Taipei',
		energyTitle: 'L’énergie de Taïwan',
		stats: [
			{ value: '≈ 95 %', label: 'de son énergie importée en 2025' },
			{ value: '≈ ½', label: 'de son électricité produite au gaz' },
			{ value: '11 jours', label: 'de stocks de GNL imposés par la loi' },
		],
		energyNote: 'Dans le Taipei Times du 21 octobre, je plaide pour une réserve stratégique inscrite au budget national et pour un travail commun avec les opérateurs européens de réseaux et de stockage de gaz.',
		energyLink: 'Lire la tribune',
	},
	en: {
		strip: 'From 23 October to 1 November, I am in Taiwan, selected by the Ministry of Foreign Affairs for its delegation of European experts and public figures.',
		stripLink: 'Energy, Kinmen, meetings',
		label: 'Mission to Taiwan',
		dateline: 'Taipei and Kinmen · 23 October – 1 November 2026',
		title: 'Invited to Taiwan by the Ministry of Foreign Affairs',
		lead: 'The Ministry selected me for its European Opinion Leaders Delegation, which brings together experts and public figures from across Europe. This is my third official invitation.',
		body: 'The programme takes us to meet Taiwanese ministers, business leaders and researchers, all the way to Kinmen, the archipelago on the front line facing Xiamen. Discussions cover, among other things, Taiwan–Europe cooperation on drones. My own focus is the energy security of an island that imports almost all of its energy.',
		contact: 'Suggest a meeting in Taipei',
		energyTitle: 'Taiwan’s energy',
		stats: [
			{ value: '≈ 95%', label: 'of its energy imported in 2025' },
			{ value: '≈ ½', label: 'of its electricity generated from gas' },
			{ value: '11 days', label: 'of LNG stocks required by law' },
		],
		energyNote: 'In the Taipei Times of 21 October, I argue for a strategic reserve written into the national budget and for joint work with European gas grid and storage operators.',
		energyLink: 'Read the op-ed',
	},
	zh: {
		strip: '10 月 23 日至 11 月 1 日，我獲外交部遴選，隨歐洲專家與知名人士訪問團訪問台灣。',
		stripLink: '能源、金門、會面',
		label: '訪台行程',
		dateline: '台北、金門 · 2026 年 10 月 23 日至 11 月 1 日',
		title: '應外交部邀請訪問台灣',
		lead: '我獲外交部遴選加入「歐洲意見領袖訪問團」，團員為來自歐洲各地的專家與知名人士。這是我第三度應邀正式訪台。',
		body: '行程中我們與台灣的部會首長、經濟界人士及研究人員會面，並前往與廈門隔海相望、位居第一線的金門。討論議題包括台灣與歐洲在無人機領域的合作。我個人則聚焦於能源安全：台灣的能源幾乎全數仰賴進口。',
		contact: '在台北與我約見',
		energyTitle: '台灣的能源',
		stats: [
			{ value: '≈ 95%', label: '2025 年能源仰賴進口' },
			{ value: '≈ ½', label: '電力來自天然氣' },
			{ value: '11 天', label: '法定液化天然氣安全存量' },
		],
		energyNote: '我在 10 月 21 日的《台北時報》主張，將戰略儲備編入國家預算，並與歐洲的天然氣輸送及儲存業者合作。',
		energyLink: '閱讀投書',
	},
}[lang];
const opedUrl = 'https://www.taipeitimes.com/News/editorials/archives/2026/10/21/2003866326';
---

{variant === 'strip' ? (
<aside class="mission-strip" aria-label={copy.label}>
	<p>
		<span class="mission-strip-text">{copy.strip}</span>
		<a href="#mission-taiwan">{copy.stripLink} <span aria-hidden="true">↓</span></a>
	</p>
</aside>
) : (
<section class="mission" id="mission-taiwan" aria-labelledby="mission-title">
	<div class="mission-inner">
		<div class="mission-main">
			<p class="mission-label">{copy.label}</p>
			<p class="mission-dateline">{copy.dateline}</p>
			<h2 id="mission-title">{copy.title}</h2>
			<p class="mission-lead">{copy.lead}</p>
			<p>{copy.body}</p>
			<a class="mission-link" href="#contact">{copy.contact} <span aria-hidden="true">→</span></a>
		</div>
		<aside class="mission-side">
			<div class="mission-energy">
				<h3>{copy.energyTitle}</h3>
				<dl class="mission-stats">
					{copy.stats.map((s) => (
						<div><dt>{s.value}</dt><dd>{s.label}</dd></div>
					))}
				</dl>
				<p class="mission-note">{copy.energyNote}</p>
				<a class="mission-link" href={opedUrl} target="_blank" rel="noopener noreferrer">{copy.energyLink} <span aria-hidden="true">↗</span></a>
			</div>
		</aside>
	</div>
</section>
)}

<style>
	.mission-strip {
		background: var(--ink);
		color: #fff;
	}
	.mission-strip p {
		max-width: var(--max);
		margin: 0 auto;
		padding: .7rem 2rem;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: .25rem 1rem;
		font-size: .9rem;
		line-height: 1.5;
		text-align: center;
	}
	.mission-strip a {
		color: #fff;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-thickness: 1px;
	}
	.mission-strip a:hover { color: var(--accent-warm); }
	.mission-strip a:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
	.mission {
		padding: 3.5rem 2rem;
		background: var(--bg-alt);
		border-top: 3px solid var(--accent-warm);
		border-bottom: 1px solid var(--line);
		color: var(--text);
		scroll-margin-top: 5rem;
	}
	.mission-inner {
		max-width: var(--max);
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: start;
	}
	.mission-label {
		display: inline-block;
		padding: .25rem .7rem;
		border-radius: 999px;
		background: var(--ink);
		color: #fff;
		font-size: .75rem;
		font-weight: 600;
		letter-spacing: .06em;
		text-transform: uppercase;
	}
	.mission-dateline { margin-top: .9rem; font-size: .9rem; font-weight: 500; color: var(--ink); }
	h2 {
		margin-top: .6rem;
		max-width: 22ch;
		font-size: clamp(1.9rem, 3.1vw, 2.65rem);
		line-height: 1.18;
		font-weight: 500;
		color: var(--ink);
	}
	.mission-main > p:not(.mission-label):not(.mission-dateline) {
		margin-top: 1rem;
		max-width: 60ch;
		font-size: 1rem;
		line-height: 1.75;
	}
	.mission-main > .mission-lead { margin-top: 1.4rem; font-size: 1.08rem; color: var(--ink); }
	.mission-side { display: grid; gap: 1.25rem; }
	.mission-energy {
		background: var(--bg);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 1.4rem 1.5rem;
	}
	h3 {
		font-family: var(--sans);
		font-size: .78rem;
		font-weight: 600;
		letter-spacing: .08em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.mission-stats {
		margin-top: 1rem;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.mission-stats dt {
		font-family: var(--display);
		font-size: clamp(1.5rem, 2.4vw, 1.9rem);
		line-height: 1.1;
		color: var(--ink);
		white-space: nowrap;
	}
	.mission-stats dd { margin-top: .35rem; font-size: .82rem; line-height: 1.45; }
	.mission-note {
		margin-top: 1.1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-size: .9rem;
		line-height: 1.65;
	}
	.mission-link {
		display: inline-flex;
		align-items: center;
		gap: .6rem;
		min-height: 44px;
		margin-top: .9rem;
		font-size: .92rem;
		font-weight: 500;
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 5px;
		text-decoration-thickness: 1px;
	}
	.mission-link:hover { color: #734837; }
	.mission-link:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
	@media (max-width: 900px) {
		.mission-inner { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
	}
	@media (max-width: 700px) {
		.mission-strip p { padding: .6rem 1rem; font-size: .85rem; }
		.mission { padding: 2.25rem 1rem; scroll-margin-top: 9rem; }
		h2 { font-size: 1.9rem; }
		.mission-energy { padding: 1.2rem 1.1rem; }
		.mission-stats { gap: .75rem; }
		.mission-stats dt { font-size: 1.4rem; }
	}
</style>
