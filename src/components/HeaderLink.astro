---
type Props = {
	href: string;
};
const { href } = Astro.props;
const pathname = new URL(Astro.request.url).pathname;
// Active on the page itself and on its children (a publication detail keeps
// « Publications » highlighted).
const normalize = (p: string) => p.replace(/\/$/, "") || "/";
const isActive = normalize(href) === normalize(pathname) || (normalize(href) !== "/" && normalize(pathname).startsWith(`${normalize(href)}/`));
---

<a href={href} class:list={["nav-link", { active: isActive }]} aria-current={isActive ? "page" : undefined}>
	<slot />
</a>
