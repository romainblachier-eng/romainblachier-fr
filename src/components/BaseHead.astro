---
import "../styles/global.css";
import { getLangFromUrl } from "../i18n/utils";

interface Props {
	title: string;
	description: string;
	image?: string | undefined;
	canonical?: string | undefined;
	/**
	 * Explicit hreflang alternates, for pages that do not share one path across
	 * locales (different slug, or no version in a given language). When omitted,
	 * alternates are derived by reusing the current path in all three languages.
	 */
	alternates?: Partial<Record<'fr' | 'en' | 'zh', string>> | undefined;
	article?: {
		publishedTime?: string;
		modifiedTime?: string;
		section?: string;
		tags?: string[];
	};
}

import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/og-default.jpg";

const lang = getLangFromUrl(Astro.url);
const ogLocaleMap: Record<string, string> = { fr: 'fr_FR', en: 'en_US', zh: 'zh_TW' };
const contentLangMap: Record<string, string> = { fr: 'fr', en: 'en', zh: 'zh-Hant' };
const ogLocale = ogLocaleMap[lang] ?? 'fr_FR';
const altLocales = Object.entries(ogLocaleMap).filter(([code]) => code !== lang).map(([, v]) => v);

const { title, description, article, canonical } = Astro.props;
// Publications canonicalize to the host publisher; everything else to self.
const canonicalURL = canonical ? canonical : new URL(Astro.url.pathname, Astro.site).toString();
// Every page of the site is indexable: noindex is never emitted, anywhere.
const robotsContent = "index, follow";

// Site-wide structured data: defines the #person node (referenced by NewsArticle
// author/publisher) and the #website node. Person carries the sameAs identity links.
const siteSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Person",
			"@id": "https://romainblachier.fr/#person",
			"name": "Romain Blachier",
			"givenName": "Romain",
			"familyName": "Blachier",
			"url": "https://romainblachier.fr/",
			"jobTitle": "Expert énergie & géopolitique, enseignant et chroniqueur",
			"knowsLanguage": ["fr", "en", "es", "zh"],
			"sameAs": [
				"https://orcid.org/0009-0008-3178-1600",
				"https://www.linkedin.com/in/romainblachier/",
				"https://france-formosa.org",
				"https://romain-blachier.com",
			],
			"knowsAbout": [
				"Géopolitique de l'énergie", "Marchés de l'énergie", "Transition énergétique",
				"Énergies renouvelables", "Taïwan", "Indo-Pacifique", "Systèmes électriques africains",
			],
			"memberOf": [
				{ "@type": "Organization", "name": "Association France-Formosa" },
				{ "@type": "Organization", "name": "Fondation Jean-Jaurès" },
			],
			"email": "romain.blachier@gmail.com",
		},
		{
			"@type": "WebSite",
			"@id": "https://romainblachier.fr/#website",
			"url": "https://romainblachier.fr/",
			"name": "Romain Blachier",
			"inLanguage": contentLangMap[lang] ?? lang,
			"publisher": { "@id": "https://romainblachier.fr/#person" },
		},
	],
};

let resolvedImage: string;
if (Astro.props.image) {
	resolvedImage = Astro.props.image;
} else {
	resolvedImage = typeof FallbackImage === "string" ? FallbackImage : (FallbackImage as ImageMetadata).src;
}
const imageURL = new URL(resolvedImage, Astro.url);

const isArticle = !!article;
const ogType = isArticle ? "article" : "website";

const pathname = Astro.url.pathname;
// Bare path shared across locales (locale prefix stripped).
const barePath = pathname.replace(/^\/(en|zh)(?=\/|$)/, '') || '/';
const localeUrl = (code: string) =>
	new URL(code === 'fr' ? barePath : `/${code}${barePath === '/' ? '/' : barePath}`, Astro.site).toString();

const { alternates } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).toString();
// An explicit map lists only the languages the page actually exists in; a missing
// entry means no alternate, not a same-path fallback.
const frUrl = alternates ? (alternates.fr ? abs(alternates.fr) : undefined) : localeUrl('fr');
const enUrl = alternates ? (alternates.en ? abs(alternates.en) : undefined) : localeUrl('en');
const zhUrl = alternates ? (alternates.zh ? abs(alternates.zh) : undefined) : localeUrl('zh');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<meta name="robots" content={robotsContent} />
<meta name="author" content="Romain Blachier" />
<meta http-equiv="content-language" content={contentLangMap[lang] ?? lang} />
{frUrl && <link rel="alternate" hreflang="fr" href={frUrl} />}
{enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
{zhUrl && <link rel="alternate" hreflang="zh-Hant" href={zhUrl} />}
{frUrl && <link rel="alternate" hreflang="x-default" href={frUrl} />}

<script is:inline>
	// Auto-redirect Traditional/Simplified Chinese browsers to the /zh/ site,
	// once per session, and never against an explicit choice made via the switcher.
	(function () {
		try {
			if (localStorage.getItem('preferred-lang')) return;
			if (sessionStorage.getItem('lang-auto')) return;
			sessionStorage.setItem('lang-auto', '1');
			var path = location.pathname;
			var seg = path.split('/')[1];
			var current = (seg === 'en' || seg === 'zh') ? seg : 'fr';
			if (current === 'zh') return;
			var langs = navigator.languages || [navigator.language || ''];
			var wantsZh = langs.some(function (l) { return /^zh\b/i.test(l); });
			if (!wantsZh) return;
			var bare = path.replace(/^\/(en|zh)(?=\/|$)/, '') || '/';
			// Article slugs differ between locales; route English deep links to the
			// Chinese blog index to avoid 404s. Default-locale (FR) slugs match /zh/.
			// Pages with no Chinese version: send the visitor to the /zh/ home
			// rather than to a /zh/… URL that does not exist.
			var noZh = ['/conseil', '/consulting', '/presse', '/press', '/recherche', '/research'];
			var target;
			if (noZh.indexOf(bare.replace(/\/$/, '')) !== -1) {
				target = '/zh/';
			} else if (current === 'en' && /^\/blog\/.+/.test(bare)) {
				target = '/zh/blog/';
			} else {
				target = '/zh' + (bare === '/' ? '/' : bare);
			}
			location.replace(target + location.search + location.hash);
		} catch (e) {}
	})();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,500&display=swap" rel="stylesheet" />
{lang === 'zh' && <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />}

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Romain Blachier" />
<meta property="og:locale" content={ogLocale} />
{altLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

{isArticle && article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{isArticle && article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{isArticle && <meta property="article:author" content="Romain Blachier" />}
{isArticle && article?.section && <meta property="article:section" content={article.section} />}
{isArticle && article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />

<link rel="sitemap" href="/sitemap-index.xml" />

<script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
