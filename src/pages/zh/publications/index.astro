---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getPublications } from '../../../lib/sections';
import { getLocalePath } from '../../../i18n/utils';
import PublicationLogo from '../../../components/PublicationLogo.astro';

const lang = 'zh';
const posts = await getPublications(lang); // 已按時間倒序排列

// 依媒體分組。媒體順序依其最新一篇文章排列（posts 已倒序），各分組內文章亦維持倒序。
const byMedia = new Map<string, { name: string; items: typeof posts }>();
for (const p of posts) {
	const slug = p.data.mediaSlug;
	if (!byMedia.has(slug)) byMedia.set(slug, { name: p.data.media, items: [] });
	byMedia.get(slug)!.items.push(p);
}
const mediaGroups = Array.from(byMedia.entries());
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={`媒體發表 | Romain Blachier`} description={`我發表於其他媒體的評論文章。`} />
		<style>
			main { width: 820px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 0.25em; }
			.pub-nav { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.6rem 0 1.5rem; }
			.pub-nav a { padding: 0.3em 0.9em; border-radius: 999px; border: 1px solid var(--line); background: white; color: var(--ink); text-decoration: none; font-size: 0.9rem; }
			.pub-nav a:hover { background: var(--ink); color: white; border-color: var(--ink); }
			.section-h { font-family: 'Playfair Display', Georgia, serif; font-size: 1.5rem; margin: 2.4rem 0 1rem; padding-top: 1.4rem; border-top: 2px solid var(--line); scroll-margin-top: 5rem; }
			.media-group { margin-bottom: 1.6rem; }
			.media-title { display: flex; align-items: center; gap: 0.6rem; font-family: 'Playfair Display', Georgia, serif; font-size: 1.2rem; margin: 1.4rem 0 0.7rem; }
			ul { list-style: none; padding: 0; margin: 0; }
			li { display: flex; gap: 0.9rem; align-items: center; margin-bottom: 1.3rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
			.media-group li { margin-bottom: 0.7rem; padding-bottom: 0.7rem; }
			.media-group li:last-child { border-bottom: none; }
			.pub-text { display: flex; flex-direction: column; min-width: 0; }
			li a.t { font-size: 1.1rem; font-weight: 600; text-decoration: none; }
			.meta { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 0.2em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>媒體發表</h1>
			<nav class="pub-nav">
				<a href="#media">依媒體</a>
				<a href="#chrono">依時間倒序</a>
			</nav>

			<h2 id="media" class="section-h">依媒體</h2>
			{mediaGroups.map(([slug, group]) => (
				<section class="media-group">
					<h3 class="media-title">
						<PublicationLogo mediaSlug={slug} media={group.name} />
						{group.name}
					</h3>
					<ul>
						{group.items.map((p) => (
							<li>
								<div class="pub-text">
									<a class="t" href={getLocalePath(lang, `/publications/${slug}/${p.id}/`)}>{p.data.title}</a>
									<span class="meta"><FormattedDate date={p.data.pubDate} lang={lang} /></span>
								</div>
							</li>
						))}
					</ul>
				</section>
			))}

			<h2 id="chrono" class="section-h">依時間倒序</h2>
			<ul>
				{posts.map((p) => (
					<li>
						<PublicationLogo mediaSlug={p.data.mediaSlug} media={p.data.media} />
						<div class="pub-text">
							<a class="t" href={getLocalePath(lang, `/publications/${p.data.mediaSlug}/${p.id}/`)}>{p.data.title}</a>
							<span class="meta">{p.data.media} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
						</div>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
