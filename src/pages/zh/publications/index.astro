---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getPublications } from '../../../lib/sections';
import { getLocalePath } from '../../../i18n/utils';
import PublicationLogo from '../../../components/PublicationLogo.astro';

const lang = 'zh';
const posts = await getPublications(lang); // 由新到舊排序
const medias = Array.from(new Map(posts.map((p) => [p.data.mediaSlug, p.data.media])).entries());
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={`媒體發表 | Romain Blachier`} description={`Romain Blachier 的評論與分析：能源、台灣與非洲，刊於《Le Temps》、《Taipei Times》、《聯合報》等多家媒體。`} />
		<style>
			main { width: 820px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 0.6rem; }
			.media-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.6rem 0 1.8rem; }
			.media-filter button { padding: 0.3em 0.9em; border-radius: 999px; border: 1px solid var(--line); background: white; color: var(--ink); cursor: pointer; font-size: 0.9rem; }
			.media-filter button:hover { border-color: var(--ink); }
			.media-filter button.active { background: var(--ink); color: white; border-color: var(--ink); }
			ul { list-style: none; padding: 0; margin: 0; }
			li { display: flex; gap: 0.9rem; align-items: center; margin-bottom: 1.3rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
			.pub-text { display: flex; flex-direction: column; min-width: 0; }
			li a.t { font-size: 1.1rem; font-weight: 600; text-decoration: none; }
			.meta { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 0.2em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>媒體發表</h1>

			<div class="media-filter" id="media-filter">
				<button class="active" data-media="all">全部媒體</button>
				{medias.map(([slug, name]) => <button data-media={slug}>{name}</button>)}
			</div>

			<ul id="pub-list">
				{posts.map((p) => (
					<li data-media={p.data.mediaSlug}>
						<PublicationLogo mediaSlug={p.data.mediaSlug} media={p.data.media} />
						<div class="pub-text">
							<a class="t" href={getLocalePath(lang, `/publications/${p.data.mediaSlug}/${p.id}/`)}>{p.data.title}</a>
							<span class="meta">{p.data.media} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
						</div>
					</li>
				))}
			</ul>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				var filter = document.getElementById('media-filter');
				if (!filter) return;
				filter.addEventListener('click', function (e) {
					var btn = e.target.closest('button');
					if (!btn) return;
					filter.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
					btn.classList.add('active');
					var media = btn.getAttribute('data-media');
					document.querySelectorAll('#pub-list > li').forEach(function (li) {
						li.style.display = media === 'all' || li.getAttribute('data-media') === media ? '' : 'none';
					});
				});
			})();
		</script>
	</body>
</html>
