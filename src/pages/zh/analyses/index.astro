---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getAnalyses, pilierLabels, PILLARS } from '../../../lib/sections';
import { getLocalePath } from '../../../i18n/utils';

const lang = 'zh';
const posts = await getAnalyses(lang);
---

<html lang="zh-Hant">
	<head>
		<BaseHead title={`分析 | Romain Blachier`} description={`關於能源與地緣政治的原創分析。`} />
		<style>
			main { width: 760px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 0.25em; }
			.lede { color: rgb(var(--gray)); font-size: 1.1rem; margin-bottom: 2rem; }
			.pillars { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2rem; }
			.pillars a { padding: 0.3em 0.9em; border-radius: 999px; background: rgba(var(--gray-light), 0.7); text-decoration: none; font-size: 0.9rem; }
			ul { list-style: none; padding: 0; }
			li { margin-bottom: 1.5rem; }
			li a.t { font-size: 1.2rem; font-weight: 600; text-decoration: none; }
			.meta { display: block; color: rgb(var(--gray)); font-size: 0.85rem; }
			.empty { color: rgb(var(--gray)); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>分析</h1>
			<p class="lede">關於能源與地緣政治的原創分析。</p>
			<nav class="pillars">
				{PILLARS.map((pl) => (
					<a href={getLocalePath(lang, `/analyses/${pl}/`)}>{pilierLabels[pl][lang]}</a>
				))}
			</nav>
			{posts.length === 0 ? <p class="empty">目前尚無內容。</p> : (
				<ul>
					{posts.map((p) => (
						<li>
							<a class="t" href={getLocalePath(lang, `/analyses/${p.data.pilier}/${p.id}/`)}>{p.data.title}</a>
							<span class="meta">{pilierLabels[p.data.pilier][lang]} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
