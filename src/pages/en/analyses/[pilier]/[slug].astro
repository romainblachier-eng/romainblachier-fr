---
import { render } from 'astro:content';
import AnalysisPost from '../../../../layouts/AnalysisPost.astro';
import { getAnalyses } from '../../../../lib/sections';

export async function getStaticPaths() {
	const posts = await getAnalyses('en');
	return posts.map((post) => ({ params: { pilier: post.data.pilier, slug: post.id }, props: post }));
}
const post = Astro.props;
const { Content } = await render(post);
---

<AnalysisPost {...post.data} lang="en">
	<Content />
</AnalysisPost>
