---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import MediaLogosBand from "../../components/MediaLogosBand.astro";
import { useTranslations } from "../../i18n/utils";

const t = useTranslations('en');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={t('travaux.seo.title')} description={t('travaux.seo.description')} />
	</head>
	<body>
		<Header />

		<!-- HERO -->
		<section class="travaux-hero">
			<div class="travaux-hero-inner">
				<h1>{t('travaux.hero.title')}</h1>
				<p class="travaux-hero-subtitle">{t('travaux.hero.subtitle')}</p>
			</div>
		</section>

		<!-- TEACHING -->
		<section class="travaux-section travaux-teaching">
			<div class="travaux-inner">
				<h2 class="section-title">{t('travaux.teaching.title')}</h2>
				<p class="travaux-intro">{t('travaux.teaching.intro')}</p>

				<div class="teaching-grid">
					<div class="teaching-institutions">
						<h3 class="travaux-label">{t('travaux.teaching.since')}</h3>
						<div class="institution-list">
							<div class="institution-item">
								<span class="institution-name">Grenoble École de Management</span>
								<span class="institution-detail">Grande École program</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">Université Lyon 1</span>
								<span class="institution-detail">University lectures</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">IEP de Lyon</span>
								<span class="institution-detail">Political science</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">ECAM Lyon</span>
								<span class="institution-detail">Engineering school</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">ILERI</span>
								<span class="institution-detail">International relations</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">HEIP</span>
								<span class="institution-detail">Comparative political systems</span>
							</div>
						</div>
					</div>

					<div class="teaching-subjects">
						<h3 class="travaux-label">{t('travaux.teaching.subjects')}</h3>
						<div class="subject-tags">
							<span class="subject-tag">Energy markets</span>
							<span class="subject-tag">Energy geopolitics</span>
							<span class="subject-tag">Energy transition</span>
							<span class="subject-tag">Energy sovereignty</span>
							<span class="subject-tag">Taiwan & Indo-Pacific</span>
							<span class="subject-tag">Comparative political systems</span>
							<span class="subject-tag">Crisis communications</span>
							<span class="subject-tag">Digital communications & web</span>
							<span class="subject-tag">Institutional relations</span>
							<span class="subject-tag">Religion & geopolitics</span>
							<span class="subject-tag">Local governance</span>
							<span class="subject-tag">Cultural economics</span>
							<span class="subject-tag">AI & education</span>
							<span class="subject-tag">Technology monitoring</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- FORMATS -->
		<section class="travaux-section" style="background: var(--bg-alt);">
			<div class="travaux-inner">
				<h2 class="section-title">Speaking formats</h2>
				<div class="formats-grid">
					<div class="format-card">
						<div class="format-icon">🎓</div>
						<h4>University course</h4>
						<p>Full semester or intensive module. Master / Grande École level. French or English.</p>
					</div>
					<div class="format-card">
						<div class="format-icon">🎤</div>
						<h4>Keynote</h4>
						<p>45 to 60 minutes. In French or English. Any audience size.</p>
					</div>
					<div class="format-card">
						<div class="format-icon">🛠️</div>
						<h4>Workshop / seminar</h4>
						<p>Half-day, interactive format. Up to 25 participants.</p>
					</div>
					<div class="format-card">
						<div class="format-icon">📡</div>
						<h4>Press interview</h4>
						<p>TV, radio, podcast. Available live or pre-recorded.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- PUBLICATIONS -->
		<section class="travaux-section travaux-publications">
			<div class="travaux-inner">
				<h2 class="section-title" style="color: var(--beige);">{t('travaux.publications.title')}</h2>
				<MediaLogosBand />

				<!-- Book -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.book')}</h3>
					<div class="pub-book">
						<div class="pub-book-info">
							<h4 class="pub-title">Guillotière(s)</h4>
							<p class="pub-meta">Les Grilles d'Or, 2016 — 108 pages</p>
							<p class="pub-meta">Foreword by Gérard Collomb</p>
							<p class="pub-desc">
								Semi-fiction about the Guillotière neighborhood in Lyon. A narrative that blends history, urban planning and neighborhood life to tell the story of one of the most singular areas of the Lyon metropolitan area.
							</p>
						</div>
					</div>
				</div>

				<!-- Recent publications -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.recent')}</h3>
					<div class="pub-recent-grid">
						<a class="pub-recent-card" href="/en/blog/ormuz-terra-nova-tensions-energetiques/">
							<div class="pub-recent-logo" aria-hidden="true">Terra Nova</div>
							<div class="pub-recent-date">April 2026</div>
							<div class="pub-recent-title">Hormuz reveals our energy tensions, in Asia as in Europe</div>
						</a>
						<a class="pub-recent-card" href="/en/blog/telos-emirats-opep-sortie/">
							<div class="pub-recent-logo" aria-hidden="true">Telos</div>
							<div class="pub-recent-date">May 2026</div>
							<div class="pub-recent-title">The UAE's exit from OPEC is not the one you think</div>
						</a>
						<a class="pub-recent-card" href="/en/blog/taiwan-energy-challenges-nottingham/">
							<div class="pub-recent-logo" aria-hidden="true">Taiwan Insight</div>
							<div class="pub-recent-date">April 2026 · peer-reviewed</div>
							<div class="pub-recent-title">Taiwan's Energy Challenges — University of Nottingham</div>
						</a>
					</div>
				</div>

				<!-- Think tanks and peer-reviewed platforms -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.scientific')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Fondation Jean-Jaurès</span>
							<span class="pub-topic">"When Taiwan's main opposition party pivots toward Beijing" (April 2026) — democratic resilience and the KMT's repositioning</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Telos</span>
							<span class="pub-topic">"The UAE's exit from OPEC is not the one you think" (May 2026) — analysis of a fifteen-year oil monetisation strategy</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Terra Nova — La Grande Conversation</span>
							<span class="pub-topic">"Hormuz reveals our energy tensions, in Asia as in Europe" (April 2026) — strait crisis and a window onto European dependencies</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Taiwan Insight (University of Nottingham)</span>
							<span class="pub-topic">"Taiwan's Energy Challenges" (April 2026) — structural vulnerability, import dependency and Taiwan's energy security</span>
						</div>
					</div>
				</div>

				<!-- International media -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.international')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Le Temps</span>
							<span class="pub-topic">"Chinese coercion in Taiwan's skies" (April 2026) — Beijing's airspace pressure and a new diplomatic precedent</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Asia Times</span>
							<span class="pub-topic">"KMT's imperialist rhetoric shifts Taiwan's democratic fault line" (April 2026) — ideological shift and the breakdown of prior diplomatic safeguards</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Taipei Times</span>
							<span class="pub-topic">Regular op-eds — AI and energy constraints (March 2026), geothermal potential (April 2026), parliamentary diplomacy (May 2026)</span>
						</div>
					</div>
				</div>

				<!-- French media -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.french')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Revue Conflits</span>
							<span class="pub-topic">"Asia's communists: is the East still red?" and "How Beijing grounded Taiwan's president" (April 2026)</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Contrepoints / IREF Europe</span>
							<span class="pub-topic">"The decline of aid to Ukraine is a danger for democracies" (2023), geopolitical analysis, European energy policy</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Le Vif / L'Express</span>
							<span class="pub-topic">Occasional analyses on energy, geopolitics and international affairs</span>
						</div>
					</div>
				</div>

				<!-- By theme -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.themes')}</h3>
					<div class="pub-themes-grid">
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.energy')}</h4>
							<p class="pub-theme-desc">Oil and gas markets, energy transition, nuclear power, hydroelectricity, semiconductors, AI and resource constraints.</p>
							<div class="pub-theme-sources">Telos · Terra Nova · Taipei Times · Taiwan Insight</div>
						</div>
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.geopolitics')}</h4>
							<p class="pub-theme-desc">Strategic chokepoints (Hormuz, Malacca), European sovereignty, OPEC, Chinese coercion, aid to Ukraine.</p>
							<div class="pub-theme-sources">Le Temps · Revue Conflits · Terra Nova · Contrepoints</div>
						</div>
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.taiwan')}</h4>
							<p class="pub-theme-desc">Taiwan's energy security, political realignments (KMT/DPP), parliamentary diplomacy, cross-strait relations.</p>
							<div class="pub-theme-sources">Taipei Times · Asia Times · Fondation Jean-Jaurès · Taiwan Insight</div>
						</div>
					</div>
				</div>

				<!-- Blog -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.blog')}</h3>
					<p class="pub-desc" style="color: var(--beige-dark);">
						Personal blog on <a href="/en/blog" style="color: var(--gold);">romainblachier.fr</a> — regular analysis on energy, geopolitics, Taiwan, French politics and cultural issues.
					</p>
				</div>
			</div>
		</section>

		<!-- RESEARCH & ENGAGEMENT -->
		<section class="travaux-section travaux-research">
			<div class="travaux-inner">
				<h2 class="section-title">{t('travaux.research.title')}</h2>

				<div class="research-grid">
					<div class="research-card">
						<div class="research-icon">🇹🇼</div>
						<h4>France-Formosa</h4>
						<p>President of the France-Formosa Association. Promoting economic and cultural exchanges between France and Taiwan. Organizing missions in partnership with the Taiwanese representation in France.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">⚡</div>
						<h4>Energy & geopolitics</h4>
						<p>18 years of experience in the energy sector (major French electricity operator). Work focused on energy markets, nuclear power, hydroelectricity, LNG and semiconductors.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">🏛️</div>
						<h4>Local governance</h4>
						<p>12 years as an elected official in the Lyon Metropolitan area. Responsibilities in culture, digital, events, and international affairs. Deputy mayor of Lyon's 7th arrondissement.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">🎭</div>
						<h4>Culture & civil society</h4>
						<p>Board member at Mediatone / Reperkusound. Engagement at the intersection of culture, sport and territory.</p>
					</div>
				</div>

				<div class="research-areas">
					<h3 class="travaux-label">{t('travaux.research.areas')}</h3>
					<div class="area-tags">
						<span class="area-tag">Energy geopolitics</span>
						<span class="area-tag">Taiwan & Indo-Pacific</span>
						<span class="area-tag">European energy sovereignty</span>
						<span class="area-tag">Energy transition</span>
						<span class="area-tag">Cultural diplomacy</span>
						<span class="area-tag">Political communications</span>
						<span class="area-tag">Territorial governance</span>
						<span class="area-tag">Religion & secularism</span>
					</div>
				</div>

				<div class="research-academia">
					<h3 class="travaux-label">Articles and publications</h3>
					<p class="pub-desc">
						Find my articles and publications on
						<a href="https://independent.academia.edu/RomainBlachier" target="_blank" rel="noopener noreferrer" style="color: var(--accent-dark); font-weight: 600;">Academia.edu →</a>
					</p>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
