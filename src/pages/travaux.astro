---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { useTranslations } from "../i18n/utils";

const t = useTranslations('fr');
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={t('travaux.seo.title')} description={t('travaux.seo.description')} />
	</head>
	<body>
		<Header />

		<!-- HERO -->
		<section class="travaux-hero">
			<div class="travaux-hero-inner">
				<h1>{t('travaux.hero.title')}</h1>
				<p class="travaux-hero-subtitle">{t('travaux.hero.subtitle')}</p>
			</div>
		</section>

		<!-- ENSEIGNEMENT -->
		<section class="travaux-section travaux-teaching">
			<div class="travaux-inner">
				<h2 class="section-title">{t('travaux.teaching.title')}</h2>
				<p class="travaux-intro">{t('travaux.teaching.intro')}</p>

				<div class="teaching-grid">
					<div class="teaching-institutions">
						<h3 class="travaux-label">{t('travaux.teaching.since')}</h3>
						<div class="institution-list">
							<div class="institution-item">
								<span class="institution-name">Sciences Po Paris</span>
								<span class="institution-detail">Cours en Master</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">Grenoble École de Management</span>
								<span class="institution-detail">Programme Grande École</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">Université Lyon 1</span>
								<span class="institution-detail">Cours universitaires</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">IEP de Lyon</span>
								<span class="institution-detail">Sciences politiques</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">ECAM Lyon</span>
								<span class="institution-detail">École d'ingénieurs</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">ILERI</span>
								<span class="institution-detail">Relations internationales</span>
							</div>
							<div class="institution-item">
								<span class="institution-name">HEIP</span>
								<span class="institution-detail">Régimes politiques comparés</span>
							</div>
						</div>
					</div>

					<div class="teaching-subjects">
						<h3 class="travaux-label">{t('travaux.teaching.subjects')}</h3>
						<div class="subject-tags">
							<span class="subject-tag">Marchés de l'énergie</span>
							<span class="subject-tag">Géopolitique de l'énergie</span>
							<span class="subject-tag">Transition énergétique</span>
							<span class="subject-tag">Souveraineté énergétique</span>
							<span class="subject-tag">Taïwan & Indo-Pacifique</span>
							<span class="subject-tag">Systèmes politiques comparés</span>
							<span class="subject-tag">Communication de crise</span>
							<span class="subject-tag">Communication numérique & web</span>
							<span class="subject-tag">Relations institutionnelles</span>
							<span class="subject-tag">Religion & géopolitique</span>
							<span class="subject-tag">Gouvernance locale</span>
							<span class="subject-tag">Économie de la culture</span>
							<span class="subject-tag">IA & enseignement</span>
							<span class="subject-tag">Veille technologique</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- PUBLICATIONS -->
		<section class="travaux-section travaux-publications">
			<div class="travaux-inner">
				<h2 class="section-title" style="color: var(--beige);">{t('travaux.publications.title')}</h2>

				<!-- Ouvrage -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.book')}</h3>
					<div class="pub-book">
						<div class="pub-book-info">
							<h4 class="pub-title">Guillotière(s)</h4>
							<p class="pub-meta">Les Grilles d'Or, 2016 — 108 pages</p>
							<p class="pub-meta">Préface de Gérard Collomb</p>
							<p class="pub-desc">
								Semi-fiction sur le quartier de la Guillotière à Lyon. Un récit qui mêle histoire, urbanisme et vie de quartier pour raconter l'un des territoires les plus singuliers de la métropole lyonnaise.
							</p>
						</div>
					</div>
				</div>

				<!-- Publications récentes -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.recent')}</h3>
					<div class="pub-recent-grid">
						<a class="pub-recent-card" href="/blog/ormuz-terra-nova-tensions-energetiques/">
							<div class="pub-recent-logo" aria-hidden="true">Terra Nova</div>
							<div class="pub-recent-date">Avril 2026</div>
							<div class="pub-recent-title">Ormuz révèle nos tensions énergétiques, en Asie comme en Europe</div>
						</a>
						<a class="pub-recent-card" href="/blog/telos-emirats-opep-sortie/">
							<div class="pub-recent-logo" aria-hidden="true">Telos</div>
							<div class="pub-recent-date">Mai 2026</div>
							<div class="pub-recent-title">La sortie des Émirats de l'OPEP n'est pas celle qu'on croit</div>
						</a>
						<a class="pub-recent-card" href="/blog/taiwan-energy-challenges-nottingham/">
							<div class="pub-recent-logo" aria-hidden="true">Taiwan Insight</div>
							<div class="pub-recent-date">Avril 2026 · à comité scientifique</div>
							<div class="pub-recent-title">Taiwan's Energy Challenges — University of Nottingham</div>
						</a>
					</div>
				</div>

				<!-- Think tanks et publications à comité scientifique -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.scientific')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Fondation Jean-Jaurès</span>
							<span class="pub-topic">« Quand le principal parti d'opposition taïwanais bascule vers Pékin » (avril 2026) — résilience démocratique et nouveau positionnement du KMT</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Telos</span>
							<span class="pub-topic">« La sortie des Émirats de l'OPEP n'est pas celle qu'on croit » (mai 2026) — analyse d'une stratégie de monétisation pétrolière sur quinze ans</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Terra Nova — La Grande Conversation</span>
							<span class="pub-topic">« Ormuz révèle nos tensions énergétiques, en Asie comme en Europe » (avril 2026) — crise du détroit et révélateur des dépendances européennes</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Taiwan Insight (University of Nottingham)</span>
							<span class="pub-topic">« Taiwan's Energy Challenges » (avril 2026) — vulnérabilité structurelle, dépendance aux importations et sécurité énergétique</span>
						</div>
					</div>
				</div>

				<!-- Médias internationaux -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.international')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Le Temps</span>
							<span class="pub-topic">« Coercition chinoise dans le ciel de Taïwan » (avril 2026) — pression aérienne de Pékin et précédent diplomatique</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Asia Times</span>
							<span class="pub-topic">« KMT's imperialist rhetoric shifts Taiwan's democratic fault line » (avril 2026) — bascule idéologique et rupture des garde-fous diplomatiques</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Taipei Times</span>
							<span class="pub-topic">Tribunes régulières — IA et contraintes énergétiques (mars 2026), potentiel géothermique (avril 2026), diplomatie parlementaire (mai 2026)</span>
						</div>
					</div>
				</div>

				<!-- Médias français -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.french')}</h3>
					<div class="pub-list">
						<div class="pub-item">
							<span class="pub-source">Revue Conflits</span>
							<span class="pub-topic">« Communistes d'Asie : l'Orient est-il toujours rouge ? » et « Comment Pékin a cloué au sol le président taïwanais » (avril 2026)</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Contrepoints / IREF Europe</span>
							<span class="pub-topic">« Le déclin de l'aide à l'Ukraine est un danger pour les démocraties » (2023), analyses géopolitiques, politique énergétique européenne</span>
						</div>
						<div class="pub-item">
							<span class="pub-source">Le Vif / L'Express</span>
							<span class="pub-topic">Analyses ponctuelles sur l'énergie, la géopolitique et les relations internationales</span>
						</div>
					</div>
				</div>

				<!-- Par thématique -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.themes')}</h3>
					<div class="pub-themes-grid">
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.energy')}</h4>
							<p class="pub-theme-desc">Marchés pétroliers et gaziers, transition énergétique, nucléaire, hydroélectricité, semi-conducteurs, IA et contraintes en ressources.</p>
							<div class="pub-theme-sources">Telos · Terra Nova · Taipei Times · Taiwan Insight</div>
						</div>
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.geopolitics')}</h4>
							<p class="pub-theme-desc">Détroits stratégiques (Ormuz, Malacca), souveraineté européenne, OPEP, coercition chinoise, aide à l'Ukraine.</p>
							<div class="pub-theme-sources">Le Temps · Revue Conflits · Terra Nova · Contrepoints</div>
						</div>
						<div class="pub-theme">
							<h4 class="pub-theme-title">{t('travaux.publications.theme.taiwan')}</h4>
							<p class="pub-theme-desc">Sécurité énergétique de Taïwan, recompositions politiques (KMT/DPP), diplomatie parlementaire, relations à travers le détroit.</p>
							<div class="pub-theme-sources">Taipei Times · Asia Times · Fondation Jean-Jaurès · Taiwan Insight</div>
						</div>
					</div>
				</div>

				<!-- Blog -->
				<div class="pub-category">
					<h3 class="travaux-label" style="color: var(--gold);">{t('travaux.publications.blog')}</h3>
					<p class="pub-desc" style="color: var(--beige-dark);">
						Blog personnel sur <a href="/blog" style="color: var(--gold);">romainblachier.fr</a> — analyses régulières sur l'énergie, la géopolitique, Taïwan, la politique française et les enjeux culturels.
					</p>
				</div>
			</div>
		</section>

		<!-- TRAVAUX & ENGAGEMENTS -->
		<section class="travaux-section travaux-research">
			<div class="travaux-inner">
				<h2 class="section-title">{t('travaux.research.title')}</h2>

				<div class="research-grid">
					<div class="research-card">
						<div class="research-icon">🇹🇼</div>
						<h4>France-Formosa</h4>
						<p>Président de l'Association France-Formosa. Promotion des échanges économiques et culturels entre la France et Taïwan. Organisation de missions en partenariat avec la représentation taïwanaise en France.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">⚡</div>
						<h4>Énergie & géopolitique</h4>
						<p>18 ans d'expérience dans le secteur de l'énergie (grand opérateur français de l'électricité). Travaux sur les marchés de l'énergie, le nucléaire, l'hydroélectricité, le GNL et les semi-conducteurs.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">🏛️</div>
						<h4>Gouvernance locale</h4>
						<p>12 ans d'élu à la Métropole de Lyon. Délégations culture, numérique, événementiel, international. Adjoint au maire du 7ᵉ arrondissement de Lyon.</p>
					</div>
					<div class="research-card">
						<div class="research-icon">🎭</div>
						<h4>Culture & société civile</h4>
						<p>Administrateur Mediatone / Reperkusound. Vice-président du FC Lyon – La Duchère. Engagement au croisement de la culture, du sport et du territoire.</p>
					</div>
				</div>

				<div class="research-areas">
					<h3 class="travaux-label">{t('travaux.research.areas')}</h3>
					<div class="area-tags">
						<span class="area-tag">Géopolitique de l'énergie</span>
						<span class="area-tag">Taïwan & Indo-Pacifique</span>
						<span class="area-tag">Souveraineté énergétique européenne</span>
						<span class="area-tag">Transition énergétique</span>
						<span class="area-tag">Diplomatie culturelle</span>
						<span class="area-tag">Communication politique</span>
						<span class="area-tag">Gouvernance territoriale</span>
						<span class="area-tag">Religion & laïcité</span>
					</div>
				</div>

				<div class="research-academia">
					<h3 class="travaux-label">Publications académiques</h3>
					<p class="pub-desc">
						Retrouvez mes travaux de recherche, articles et publications sur
						<a href="https://independent.academia.edu/RomainBlachier" target="_blank" rel="noopener noreferrer" style="color: var(--accent-dark); font-weight: 600;">Academia.edu →</a>
					</p>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
