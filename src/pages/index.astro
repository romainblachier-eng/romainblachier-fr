---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import { HeroGeometric } from "../components/ui/shape-landing-hero";
import MediaLogosBand from "../components/MediaLogosBand.astro";
import ContactForm from "../components/ContactForm.astro";
import TrainingLogosBand from "../components/TrainingLogosBand.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getPublications } from "../lib/sections";

const t = useTranslations('fr');
const allPubs = await getPublications('fr');
const recentPubs = allPubs.slice(0, 3);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "https://romainblachier.fr/#website",
					"url": "https://romainblachier.fr/",
					"name": "Romain Blachier — Énergie & Géopolitique",
					"description": "Énergie et géopolitique. Conférences, formations, chroniques médias.",
					"publisher": { "@id": "https://romainblachier.fr/#person" },
					"inLanguage": "fr-FR"
				},
				{
					"@type": "Person",
					"@id": "https://romainblachier.fr/#person",
					"name": "Romain Blachier",
					"givenName": "Romain",
					"familyName": "Blachier",
					"jobTitle": "Formateur & Conférencier — Énergie & Géopolitique",
					"description": "Formateur et conférencier en énergie et géopolitique. 18 ans d'expérience dans le secteur de l'énergie. Formations sur mesure et enseignement en grandes écoles.",
					"url": "https://romainblachier.fr/",
					"sameAs": [
						"https://www.linkedin.com/in/romainblachier",
						"https://romain-blachier.com"
					],
					"knowsAbout": [
						"Géopolitique de l'énergie", "Taïwan", "Indo-Pacifique",
						"Énergie nucléaire", "Transition énergétique", "Énergies renouvelables", "Marchés de l'énergie"
					],
					"alumniOf": [{ "@type": "EducationalOrganization", "name": "Sciences Po Paris" }],
					"memberOf": [
							{ "@type": "Organization", "name": "Association France-Formosa", "roleName": "Président" },
							{ "@type": "Organization", "name": "Fondation Jean-Jaurès", "roleName": "Expert associé" }
						],
					"knowsLanguage": ["fr", "en", "es", "zh"],
					"email": "romain.blachier@gmail.com"
				}
			]
		})} />

		<Header />

		<HeroGeometric
			client:load
			badge={t('hero.subtitle')}
			title1="Romain"
			title2="Blachier"
			description={t('hero.pitch')}
			ctaHref="#contact"
			ctaLabel={`${t('hero.cta')} →`}
		/>

		{recentPubs.length > 0 && (
		<section class="latest-article">
			<div class="latest-inner latest-inner--grid">
				<div class="section-overline" style="text-align:center">{t('latest.overline')}</div>
				<h2 class="section-title">{t('latest.title')}</h2>
				<div class="latest-grid">
					{recentPubs.map((pub) => (
						<article class="latest-card">
							<div class="latest-meta">
								<span class="latest-media">{pub.data.media}</span>
								<span class="latest-date"><FormattedDate date={pub.data.pubDate} lang="fr" /></span>
							</div>
							<h3 class="latest-headline">{pub.data.title}</h3>
							<p class="latest-desc">{pub.data.description}</p>
							<div class="latest-actions">
								<a href={pub.data.lienCanonique} target="_blank" rel="noopener noreferrer" class="latest-cta">{t('latest.read')}</a>
							</div>
						</article>
					))}
				</div>
				<div class="latest-all-wrap">
					<a href="/publications/" class="latest-all">{t('latest.all')}</a>
				</div>
			</div>
		</section>
		)}

		<MediaLogosBand />

		<section class="about">
			<div class="about-inner">
				<div class="about-left">
					<div class="hero-photo">
						<div class="hero-photo-frame">
							<Image src={portrait} alt="Romain Blachier" width={380} height={507} />
						</div>
					</div>
				</div>
				<div class="about-right">
					<h2 class="about-label">{t('about.title')}</h2>
					<div class="about-text">
						<p>{t('about.p1')}</p>
						<p>{t('about.p2')}</p>
						<p>{t('about.p3')}</p>
						<p>{t('about.p4')}</p>
						<p>{t('about.p5')}</p>
						<p>{t('about.p6')}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="services">
			<div class="services-inner">
				<div class="section-overline" style="text-align:center">Services</div>
				<h2 class="section-title">{t('services.title')}</h2>
				<div class="services-grid">
					<div class="service-card">
						<div class="service-icon">🎓</div>
						<h3>{t('services.teaching.title')}</h3>
						<p>{t('services.teaching.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">📡</div>
						<h3>{t('services.media.title')}</h3>
						<p>{t('services.media.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">🎤</div>
						<h3>{t('services.speaking.title')}</h3>
						<p>{t('services.speaking.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">🧭</div>
						<h3>{t('services.comms.title')}</h3>
						<p>{t('services.comms.desc')}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="formateur" id="formateur">
			<div class="formateur-inner">
				<div class="section-overline" style="text-align:center">{t('formateur.overline')}</div>
				<h2 class="section-title">{t('formateur.title')}</h2>
				<p class="formateur-intro">{t('formateur.intro')}</p>
				<TrainingLogosBand heading={t('formateur.clients')} />
				<div class="formateur-stats">
					<div class="formateur-stat">
						<span class="formateur-stat-number">{t('formateur.stat.years')}</span>
						<span class="formateur-stat-label">{t('formateur.stat.years.label')}</span>
					</div>
					<div class="formateur-stat">
						<span class="formateur-stat-number">{t('formateur.stat.languages')}</span>
						<span class="formateur-stat-label">{t('formateur.stat.languages.label')}</span>
					</div>
				</div>
				<div class="formateur-grid">
					<div class="formateur-card">
						<div class="formateur-card-icon">🏛️</div>
						<h3>{t('formateur.academic.title')}</h3>
						<p>{t('formateur.academic.desc')}</p>
					</div>
					<div class="formateur-card">
						<div class="formateur-card-icon">🎯</div>
						<h3>{t('formateur.custom.title')}</h3>
						<p>{t('formateur.custom.desc')}</p>
					</div>
					<div class="formateur-card">
						<div class="formateur-card-icon">🎤</div>
						<h3>{t('formateur.conference.title')}</h3>
						<p>{t('formateur.conference.desc')}</p>
					</div>
					<div class="formateur-card">
						<div class="formateur-card-icon">⚖️</div>
						<h3>{t('formateur.elus.title')}</h3>
						<p>{t('formateur.elus.desc')}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="sujets">
			<div class="sujets-inner">
				<div class="section-overline">Thématiques</div>
				<h2 class="section-title">{t('topics.title')}</h2>
				<div class="tags-wrap">
					<span class="tag hi">{t('tag.energy_markets')}</span>
					<span class="tag hi">{t('tag.geopolitics')}</span>
					<span class="tag hi">{t('tag.taiwan')}</span>
					<span class="tag hi">{t('tag.nuclear')}</span>
					<span class="tag hi">{t('tag.transition')}</span>
					<span class="tag hi">{t('tag.renewables')}</span>
					<span class="tag hi">{t('tag.sovereignty')}</span>
				</div>
				<details class="tags-more">
					<summary class="tags-toggle">Voir toutes les thématiques</summary>
					<div class="tags-wrap" style="margin-top: .75rem;">
						<span class="tag">{t('tag.hydro')}</span>
						<span class="tag">{t('tag.public_affairs')}</span>
						<span class="tag">{t('tag.institutional')}</span>
						<span class="tag">{t('tag.political_systems')}</span>
						<span class="tag">{t('tag.crisis_comms')}</span>
						<span class="tag">{t('tag.religion')}</span>
						<span class="tag">{t('tag.local_gov')}</span>
						<span class="tag">{t('tag.digital_comms')}</span>
						<span class="tag">{t('tag.seo')}</span>
						<span class="tag">{t('tag.ai_teaching')}</span>
						<span class="tag">{t('tag.cultural_policy')}</span>
						<span class="tag">{t('tag.culture_economy')}</span>
						<span class="tag">{t('tag.music')}</span>
						<span class="tag">{t('tag.cultural_diplomacy')}</span>
						<span class="tag">{t('tag.scientific_coop')}</span>
					</div>
				</details>
			</div>
		</section>

		<section class="references">
			<div class="references-inner">
				<div class="section-overline" style="text-align:center">Parcours</div>
				<h2 class="section-title">{t('references.title')}</h2>
				<div class="ref-grid">
					<div class="ref-col">
						<h3>{t('references.teaching')}</h3>
						<ul>
							<li>Sciences Po Paris</li>
							<li>Grenoble École de Management</li>
							<li>ECAM Lyon</li>
							<li>ILERI</li>
							<li>HEIP</li>
						</ul>
					</div>
					<div class="ref-col">
						<h3>{t('references.culture')}</h3>
						<ul>
							<li>Président, Association France-Formosa</li>
							<li>Administrateur, Mediatone / Reperkusound</li>
							<li>Auteur, <em>Guillotière(s)</em></li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="contact-section" id="contact">
			<div class="contact-inner">
				<div class="contact-left">
					<h2>{t('contact.title')}</h2>
					<p>{t('contact.desc')}</p>
					<div class="contact-links">
						<a href="mailto:romain.blachier@gmail.com">✉ romain.blachier@gmail.com</a>
						<a href="https://www.linkedin.com/in/romainblachier/" target="_blank" rel="noopener noreferrer">→ LinkedIn</a>
						<a href="https://sciencespo.academia.edu/RomainBlachier" target="_blank" rel="noopener noreferrer">→ Academia</a>
						<a href="https://orcid.org/0009-0008-3178-1600" target="_blank" rel="noopener noreferrer">→ ORCID</a>
					</div>
					<div class="contact-cv">
						<a href="https://romain-blachier.com" target="_blank" rel="noopener noreferrer">{t('contact.cv')}</a>
					</div>
				</div>
				<ContactForm lang="fr" />
			</div>
		</section>

		<Footer />
	</body>
</html>
