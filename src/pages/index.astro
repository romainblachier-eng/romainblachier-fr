---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---


<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
	<!-- Schema.org JSON-LD : Person + ProfessionalService -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "https://romainblachier.fr/#website",
					"url": "https://romainblachier.fr/",
					"name": "Romain Blachier — Expert Énergie & Géopolitique",
					"description": "Expert franco-taïwanais en énergie et géopolitique. Conférences, formations, chroniques médias.",
					"publisher": { "@id": "https://romainblachier.fr/#person" },
					"inLanguage": "fr-FR"
				},
				{
					"@type": "Person",
					"@id": "https://romainblachier.fr/#person",
					"name": "Romain Blachier",
					"givenName": "Romain",
					"familyName": "Blachier",
					"jobTitle": "Expert Énergie & Géopolitique",
					"description": "Expert franco-taïwanais en énergie et géopolitique. 18 ans d'expérience dans le secteur de l'énergie. Conférencier, enseignant et chroniqueur.",
					"url": "https://romainblachier.fr/",
					"sameAs": [
						"https://www.linkedin.com/in/romainblachier",
						"https://www.tiktok.com/@finbookie",
						"https://romain-blachier.com"
					],
					"knowsAbout": [
						"Géopolitique de l'énergie", "Taïwan", "Indo-Pacifique",
						"Énergie nucléaire", "Transition énergétique", "Marchés de l'énergie",
						"Semi-conducteurs", "GNL", "Communication stratégique"
					],
					"alumniOf": [{ "@type": "EducationalOrganization", "name": "Sciences Po Paris" }],
					"memberOf": [{ "@type": "Organization", "name": "Association France-Formosa", "roleName": "Président" }],
					"hasOccupation": [
						{ "@type": "Occupation", "name": "Conférencier en géopolitique de l'énergie" },
						{ "@type": "Occupation", "name": "Enseignant en géopolitique" },
						{ "@type": "Occupation", "name": "Expert énergie et consultant" }
					],
					"knowsLanguage": ["fr", "en", "zh"],
					"email": "contact@rb-webconsultant.net"
				},
				{
					"@type": "ProfessionalService",
					"@id": "https://romainblachier.fr/#service",
					"name": "Romain Blachier — Conférences & Formations",
					"provider": { "@id": "https://romainblachier.fr/#person" },
					"serviceType": [
						"Conférences géopolitique de l'énergie",
						"Formations marchés de l'énergie",
						"Expertise médias",
						"Conseil en communication stratégique"
					],
					"areaServed": { "@type": "Country", "name": "France" },
					"url": "https://romainblachier.fr/"
				}
			]
		})} />

		<Header />


		<!-- HERO -->
		<section class="hero">
			<div class="hero-inner">
				<div class="hero-star">
					<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path
							d="M12 2L15.09 10.26H24L17.45 15.74L20.54 24L12 18.52L3.46 24L6.55 15.74L0 10.26H8.91L12 2Z"
							fill="currentColor"
						/>
					</svg>
				</div>
				<h1 class="hero-name">Romain Blachier</h1>
				<p class="hero-subtitle">
					Expert énergie & géopolitique · Enseignant · Chroniqueur ·
					Communication
				</p>
				<p class="hero-pitch">
					Besoin d'un expert pour votre prochain plateau TV sur l'énergie ?
					D'un enseignant pour vos programmes en géopolitique ? D'un
					conférencier qui sait captiver un auditoire ? Vous êtes au bon
					endroit.
