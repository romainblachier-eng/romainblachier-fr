---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import portrait from "../assets/portrait.jpg";

const t = useTranslations('fr');
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": "https://romainblachier.fr/#website",
					"url": "https://romainblachier.fr/",
					"name": "Romain Blachier — Expert Énergie & Géopolitique",
					"description": "Expert en énergie et géopolitique. Conférences, formations, chroniques médias.",
					"publisher": { "@id": "https://romainblachier.fr/#person" },
					"inLanguage": "fr-FR"
				},
				{
					"@type": "Person",
					"@id": "https://romainblachier.fr/#person",
					"name": "Romain Blachier",
					"givenName": "Romain",
					"familyName": "Blachier",
					"jobTitle": "Expert Énergie & Géopolitique",
					"description": "Expert en énergie et géopolitique. 18 ans d'expérience dans le secteur de l'énergie.",
					"url": "https://romainblachier.fr/",
					"sameAs": [
						"https://www.linkedin.com/in/romainblachier",
						"https://romain-blachier.com"
					],
					"knowsAbout": [
						"Géopolitique de l'énergie", "Taïwan", "Indo-Pacifique",
						"Énergie nucléaire", "Transition énergétique", "Marchés de l'énergie"
					],
					"alumniOf": [{ "@type": "EducationalOrganization", "name": "Sciences Po Paris" }],
					"memberOf": [{ "@type": "Organization", "name": "Association France-Formosa", "roleName": "Président" }],
					"knowsLanguage": ["fr", "en", "zh"],
					"email": "contact@rb-webconsultant.net"
				}
			]
		})} />

		<Header />

		<section class="hero">
			<div class="hero-inner">
				<div class="hero-content">
					<div class="hero-kicker">{t('hero.subtitle')}</div>
					<h1 class="hero-name">Romain<br/>Blachier</h1>
					<p class="hero-pitch">{t('hero.pitch')}</p>
					<div class="hero-ctas">
						<a href="#contact" class="btn btn-primary">{t('hero.cta')} →</a>
						<a href="/blog/" class="btn btn-outline">Blog</a>
					</div>
				</div>
				<div class="hero-photo">
					<div class="hero-photo-frame">
						<Image src={portrait} alt="Romain Blachier" width={760} height={1000} loading="eager" />
					</div>
				</div>
			</div>
		</section>

		<section class="about">
			<div class="about-inner">
				<h2 class="about-label">{t('about.title')}</h2>
				<div class="about-text">
					<p>{t('about.p1')}</p>
					<p>{t('about.p2')}</p>
					<p>{t('about.p3')}</p>
					<p>{t('about.p4')}</p>
					<p>{t('about.p5')}</p>
					<p>{t('about.p6')}</p>
				</div>
			</div>
		</section>

		<section class="services">
			<div class="services-inner">
				<div class="section-overline" style="text-align:center">Services</div>
				<h2 class="section-title">{t('services.title')}</h2>
				<div class="services-grid">
					<div class="service-card">
						<div class="service-icon">🎓</div>
						<h3>{t('services.teaching.title')}</h3>
						<p>{t('services.teaching.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">📡</div>
						<h3>{t('services.media.title')}</h3>
						<p>{t('services.media.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">🎤</div>
						<h3>{t('services.speaking.title')}</h3>
						<p>{t('services.speaking.desc')}</p>
					</div>
					<div class="service-card">
						<div class="service-icon">🧭</div>
						<h3>{t('services.comms.title')}</h3>
						<p>{t('services.comms.desc')}</p>
					</div>
				</div>
			</div>
		</section>

		<section class="sujets">
			<div class="sujets-inner">
				<div class="section-overline">Expertise</div>
				<h2 class="section-title">{t('expertise.title')}</h2>
				<div class="tags-wrap">
					<span class="tag">{t('tag.energy_markets')}</span>
					<span class="tag">{t('tag.taiwan')}</span>
					<span class="tag">{t('tag.geopolitics')}</span>
					<span class="tag">{t('tag.cultural_policy')}</span>
					<span class="tag">{t('tag.hydro')}</span>
					<span class="tag">{t('tag.nuclear')}</span>
					<span class="tag">{t('tag.transition')}</span>
					<span class="tag">{t('tag.sovereignty')}</span>
					<span class="tag">{t('tag.public_affairs')}</span>
					<span class="tag">{t('tag.institutional')}</span>
					<span class="tag">{t('tag.political_systems')}</span>
					<span class="tag">{t('tag.crisis_comms')}</span>
					<span class="tag">{t('tag.religion')}</span>
					<span class="tag">{t('tag.local_gov')}</span>
					<span class="tag">{t('tag.digital_comms')}</span>
					<span class="tag hi">{t('tag.seo')}</span>
					<span class="tag">{t('tag.ai_teaching')}</span>
					<span class="tag">{t('tag.culture_economy')}</span>
					<span class="tag">{t('tag.music')}</span>
					<span class="tag">{t('tag.cultural_diplomacy')}</span>
					<span class="tag">{t('tag.scientific_coop')}</span>
				</div>
			</div>
		</section>

		<section class="references">
			<div class="references-inner">
				<div class="section-overline" style="text-align:center">Track record</div>
				<h2 class="section-title">{t('references.title')}</h2>
				<div class="ref-grid">
					<div class="ref-col">
						<h3>{t('references.teaching')}</h3>
						<ul>
							<li>Sciences Po Paris</li>
							<li>Grenoble École de Management</li>
							<li>IEP de Lyon</li>
							<li>ILERI</li>
							<li>HEIP</li>
						</ul>
					</div>
					<div class="ref-col">
						<h3>{t('references.experience')}</h3>
						<div style="margin-bottom: 1.5rem;">
							<div class="ref-big">18 ans</div>
							<div class="ref-cap">
								{t('references.experience.energy')}<br />Grand opérateur français de l'électricité
							</div>
						</div>
						<div>
							<div class="ref-big">12 ans</div>
							<div class="ref-cap">
								{t('references.experience.elected')}<br />{t('references.experience.elected.detail')}
							</div>
						</div>
					</div>
					<div class="ref-col">
						<h3>{t('references.culture')}</h3>
						<ul>
							<li>Président, Association France-Formosa</li>
							<li>Administrateur, Mediatone / Reperkusound</li>
							<li>Vice-président, FC Lyon – La Duchère</li>
							<li>Auteur, <em>Guillotière(s)</em></li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="contact-section" id="contact">
			<div class="contact-inner">
				<div class="contact-left">
					<h2>{t('contact.title')}</h2>
					<p>{t('contact.desc')}</p>
					<div class="contact-links">
						<a href="mailto:contact@rb-webconsultant.net">✉ contact@rb-webconsultant.net</a>
						<a href="https://www.linkedin.com/in/romainblachier/" target="_blank" rel="noopener noreferrer">→ LinkedIn</a>
					</div>
					<div class="contact-cv">
						<a href="https://romain-blachier.com" target="_blank" rel="noopener noreferrer">{t('contact.cv')}</a>
					</div>
				</div>
				<form class="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
					<input type="hidden" name="form-name" value="contact" />
					<p style="display:none"><label>Ne pas remplir : <input name="bot-field" /></label></p>
					<div class="form-row">
						<input type="text" name="name" placeholder={t('contact.name')} required />
						<input type="email" name="email" placeholder={t('contact.email')} required />
					</div>
					<input type="text" name="subject" placeholder={t('contact.subject')} required />
					<textarea name="message" placeholder={t('contact.message')} required></textarea>
					<button type="submit">{t('contact.send')} →</button>
				</form>
			</div>
		</section>

		<Footer />
	</body>
</html>
