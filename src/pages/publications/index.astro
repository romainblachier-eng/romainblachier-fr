---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublications } from '../../lib/sections';
import { getLocalePath } from '../../i18n/utils';
import PublicationLogo from '../../components/PublicationLogo.astro';

const lang = 'fr';
const posts = await getPublications(lang); // triées du plus récent au moins récent
// Les textes antérieurs à 2018 relèvent de la période d'engagement politique.
// Ils restent en ligne et filtrables, mais repliés : deux corpus distincts ne se
// lisent pas dans la même liste.
const ARCHIVE_BEFORE = 2018;
const recent = posts.filter((p) => p.data.pubDate.getFullYear() >= ARCHIVE_BEFORE);
const archive = posts.filter((p) => p.data.pubDate.getFullYear() < ARCHIVE_BEFORE);
const medias = Array.from(new Map(posts.map((p) => [p.data.mediaSlug, p.data.media])).entries());
---

<html lang="fr">
	<head>
		<BaseHead title={`Publications | Romain Blachier`} description={`Tribunes et analyses de Romain Blachier sur l'énergie, Taïwan et l'Afrique : Le Temps, Taipei Times, Revue Conflits, African Arguments et d'autres médias.`} />
		<style>
			main { width: 820px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 0.6rem; }
		.press-hint { color: var(--muted); font-size: 0.9rem; margin: 0 0 1rem; }
			.media-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.6rem 0 1.8rem; }
			.media-filter button { padding: 0.3em 0.9em; border-radius: 999px; border: 1px solid var(--line); background: white; color: var(--ink); cursor: pointer; font-size: 0.9rem; }
			.media-filter button:hover { border-color: var(--ink); }
			.media-filter button.active { background: var(--ink); color: white; border-color: var(--ink); }
			ul { list-style: none; padding: 0; margin: 0; }
			li { display: flex; gap: 0.9rem; align-items: center; margin-bottom: 1.3rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--line); }
			.pub-text { display: flex; flex-direction: column; min-width: 0; }
			li a.t { font-size: 1.1rem; font-weight: 600; text-decoration: none; }
			.pub-archive { margin-top: 2.5rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
			.pub-archive > summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; list-style-position: outside; }
			.pub-archive > summary:hover { color: var(--ink); }
			.pub-archive[open] > summary { margin-bottom: 1.3rem; }
			.meta { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 0.2em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Publications</h1>
			<p class="press-hint">Journaliste&nbsp;? Bios prêtes à l'emploi, photo et contact direct sur la <a href="/presse/">page presse</a>.</p>

			<div class="media-filter" id="media-filter">
				<button class="active" data-media="all">Tous les médias</button>
				{medias.map(([slug, name]) => <button data-media={slug}>{name}</button>)}
			</div>

			<ul id="pub-list">
				{recent.map((p) => (
					<li data-media={p.data.mediaSlug}>
						<PublicationLogo mediaSlug={p.data.mediaSlug} media={p.data.media} />
						<div class="pub-text">
							<a class="t" href={getLocalePath(lang, `/publications/${p.data.mediaSlug}/${p.id}/`)}>{p.data.title}</a>
							<span class="meta">{p.data.media} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
						</div>
					</li>
				))}
			</ul>

			{archive.length > 0 && (
			<details class="pub-archive">
				<summary>Archives 2012-2017 — textes de la période d’engagement politique</summary>
				<ul id="pub-archive-list">
					{archive.map((p) => (
						<li data-media={p.data.mediaSlug}>
							<PublicationLogo mediaSlug={p.data.mediaSlug} media={p.data.media} />
							<div class="pub-text">
								<a class="t" href={getLocalePath(lang, `/publications/${p.data.mediaSlug}/${p.id}/`)}>{p.data.title}</a>
								<span class="meta">{p.data.media} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
							</div>
						</li>
					))}
				</ul>
			</details>
			)}
		</main>
		<Footer />

		<script is:inline>
			(function () {
				var filter = document.getElementById('media-filter');
				if (!filter) return;
				filter.addEventListener('click', function (e) {
					var btn = e.target.closest('button');
					if (!btn) return;
					filter.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
					btn.classList.add('active');
					var media = btn.getAttribute('data-media');
					document.querySelectorAll('#pub-list > li, #pub-archive-list > li').forEach(function (li) {
						li.style.display = media === 'all' || li.getAttribute('data-media') === media ? '' : 'none';
					});
				});
			})();
		</script>
	</body>
</html>
