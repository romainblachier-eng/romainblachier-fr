---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublications } from '../../lib/sections';
import { getLocalePath } from '../../i18n/utils';

const lang = 'fr';
const posts = await getPublications(lang);
const medias = Array.from(new Map(posts.map((p) => [p.data.mediaSlug, p.data.media])).entries());
const years = Array.from(new Set(posts.map((p) => new Date(p.data.pubDate).getFullYear()))).sort((a, b) => b - a);
---

<html lang="fr">
	<head>
		<BaseHead title={`Publications | Romain Blachier`} description={`Mes tribunes parues dans d'autres médias.`} />
		<style>
			main { width: 820px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; margin-bottom: 0.25em; }
			.lede { color: rgb(var(--gray)); font-size: 1.1rem; margin-bottom: 1.5rem; }
			.filters { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.6rem; }
			.filters button { padding: 0.25em 0.8em; border-radius: 999px; border: 1px solid rgb(var(--gray-light)); background: white; cursor: pointer; font-size: 0.85rem; }
			.filters button.active { background: rgb(var(--black)); color: white; border-color: rgb(var(--black)); }
			ul { list-style: none; padding: 0; }
			li { margin-bottom: 1.3rem; padding-bottom: 1.3rem; border-bottom: 1px solid rgba(var(--gray-light), 0.7); }
			li a.t { font-size: 1.15rem; font-weight: 600; text-decoration: none; }
			.meta { display: block; color: rgb(var(--gray)); font-size: 0.85rem; margin-top: 0.2em; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Publications</h1>
			<p class="lede">Mes tribunes parues dans d'autres médias.</p>

			<div class="filters" data-group="media">
				<button class="active" data-media="all">Tous</button>
				{medias.map(([slug, name]) => <button data-media={slug}>{name}</button>)}
			</div>
			<div class="filters" data-group="year">
				<button class="active" data-year="all">Tous</button>
				{years.map((y) => <button data-year={String(y)}>{y}</button>)}
			</div>

			<ul id="pub-list">
				{posts.map((p) => (
					<li data-media={p.data.mediaSlug} data-year={String(new Date(p.data.pubDate).getFullYear())}>
						<a class="t" href={getLocalePath(lang, `/publications/${p.data.mediaSlug}/${p.id}/`)}>{p.data.title}</a>
						<span class="meta">{p.data.media} · <FormattedDate date={p.data.pubDate} lang={lang} /></span>
					</li>
				))}
			</ul>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				var state = { media: 'all', year: 'all' };
				function apply() {
					document.querySelectorAll('#pub-list > li').forEach(function (li) {
						var okM = state.media === 'all' || li.getAttribute('data-media') === state.media;
						var okY = state.year === 'all' || li.getAttribute('data-year') === state.year;
						li.style.display = okM && okY ? '' : 'none';
					});
				}
				document.querySelectorAll('.filters').forEach(function (group) {
					var key = group.getAttribute('data-group');
					group.querySelectorAll('button').forEach(function (btn) {
						btn.addEventListener('click', function () {
							group.querySelectorAll('button').forEach(function (b) { b.classList.remove('active'); });
							btn.classList.add('active');
							state[key] = btn.getAttribute('data-' + key);
							apply();
						});
					});
				});
			})();
		</script>
	</body>
</html>
