---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getAnalyses, pilierLabels, PILLARS } from '../../../lib/sections';
import { getLocalePath } from '../../../i18n/utils';

export async function getStaticPaths() {
	return PILLARS.map((pilier) => ({ params: { pilier }, props: { pilier } }));
}
const { pilier } = Astro.props;
const lang = 'fr';
const label = pilierLabels[pilier][lang];
const posts = (await getAnalyses(lang)).filter((p) => p.data.pilier === pilier);
---

<html lang="fr">
	<head>
		<BaseHead title={`${label} — Analyses | Romain Blachier`} description={`Analyses originales sur l'énergie et la géopolitique.`} />
		<style>
			main { width: 720px; max-width: calc(100% - 2em); margin: 0 auto; padding: 2rem 1rem 3rem; }
			h1 { font-family: 'Playfair Display', Georgia, serif; }
			ul { list-style: none; padding: 0; }
			li { margin-bottom: 1.5rem; }
			li a { font-size: 1.2rem; font-weight: 600; text-decoration: none; }
			.date { display: block; color: rgb(var(--gray)); font-size: 0.85rem; }
			.empty { color: rgb(var(--gray)); }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p><a href={getLocalePath(lang, '/analyses/')}>← Analyses</a></p>
			<h1>{label}</h1>
			{posts.length === 0 ? <p class="empty">Aucun contenu pour le moment.</p> : (
				<ul>
					{posts.map((p) => (
						<li>
							<a href={getLocalePath(lang, `/analyses/${pilier}/${p.id}/`)}>{p.data.title}</a>
							<FormattedDate date={p.data.pubDate} lang={lang} />
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
